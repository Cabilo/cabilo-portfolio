---
import { getCollection, render } from 'astro:content';
import Layout from '../../layouts/Layout.astro';
import MediaBlocksRenderer from '../../components/MediaBlocksRenderer.astro';
import LayoutBlocksRenderer from '../../components/LayoutBlocksRenderer.astro';
import { getVideoEmbed } from '../../lib/video';
import { slugifyTaxonomyValue } from '../../lib/taxonomy';
import ProjectBreakdown from '../../components/ProjectBreakdown.astro';

export async function getStaticPaths() {
  const projects = await getCollection('projects');
  return projects.map(project => ({
    params: { id: project.id },
    props: { project },
  }));
}

const { project } = Astro.props;
const { Content } = await render(project);
const mediaBlocks = project.data.mediaBlocks ?? [];
const layoutBlocks = project.data.layoutBlocks ?? [];
const showreel = getVideoEmbed(project.data.showreelUrl);

---

<Layout 
  title={`${project.data.title} | CABILO`}
  description={`Breakdown of ${project.data.title} - ${project.data.category} by CABILO.`}
  image={project.data.thumbnail}
>
  <main class="px-4 py-12 md:py-20">

    <div class="cabilo-reading mb-12">
      <h1 class="text-4xl md:text-5xl font-bold text-text-white mb-4 uppercase">{project.data.title}</h1>
      <div class="flex flex-wrap gap-4 text-sm tracking-widest text-brand-gold uppercase">
        <span>{project.data.category}</span>
        <span>•</span>
        <span>{project.data.role}</span>
        <span>•</span>
        <span>{project.data.client}</span>
      </div>

      {project.data.tags?.length > 0 && (
        <div class="flex flex-wrap gap-2 mt-5">
          {project.data.tags.map((tag) => (
            <a
              href={`/tags/${slugifyTaxonomyValue(tag)}`}
              class="text-xs font-bold tracking-widest uppercase text-brand-gold bg-brand-gold/10 px-3 py-1.5 rounded"
            >
              {tag}
            </a>
          ))}
        </div>
      )}
    </div>

    {showreel && (
      <div
        class:list={[
          'cabilo-media mb-16 rounded-md overflow-hidden shadow-2xl border border-cabilo-card relative',
          project.data.showreelFitToViewport
            ? 'cabilo-video-fit'
            : 'w-full aspect-video',
        ]}
      >
        {showreel.type === 'youtube' || showreel.type === 'vimeo' ? (
          <iframe
            class:list={[
              'absolute inset-0 w-full h-full',
              project.data.showreelFitToViewport ? 'object-contain' : 'object-cover',
            ]}
            src={showreel.src}
            frameborder="0"
            allow="autoplay; fullscreen; picture-in-picture"
            allowfullscreen
          ></iframe>
        ) : showreel.type === 'direct' ? (
          <video
            class:list={[
              'absolute inset-0 w-full h-full',
              project.data.showreelFitToViewport ? 'object-contain' : 'object-cover',
            ]}
            src={showreel.src}
            autoplay
            muted
            loop
            playsinline
            controls
          ></video>
        ) : (
          <div class="absolute inset-0 flex items-center justify-center bg-cabilo-dark p-8"><p class="text-text-silver">Video URL could not be recognized.</p></div>
        )}
      </div>
    )}

    <!-- PLUG IN THE MASTER MEDIA BLOCKS NODE! -->
    <div class="cabilo-media">
      <MediaBlocksRenderer blocks={mediaBlocks} />
    </div>

    {layoutBlocks.length > 0 && (
      <div class="cabilo-media mb-16">
        <LayoutBlocksRenderer blocks={layoutBlocks} />
      </div>
    )}

    <ProjectBreakdown
      Content={Content}
      softwareUsed={project.data.softwareUsed}
    />

  </main>
</Layout>
