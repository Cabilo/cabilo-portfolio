---
import { getCollection, render } from 'astro:content';
import Layout from '../../layouts/Layout.astro';
import DynamicAov from '../../components/DynamicAov.astro';
import TurntableScrubber from '../../components/TurntableScrubber.astro';

// We import Node's internal file system tools
import fs from 'node:fs';
import path from 'node:path';

export async function getStaticPaths() {
  const projects = await getCollection('projects');
  return projects.map(project => ({
    params: { id: project.id },
    props: { project },
  }));
}

const { project } = Astro.props;
const { Content } = await render(project);

// THE AUTO-DETECTOR
let generatedFrames: string[] = [];
if (project.data.turntable) {
  // 1. Find the exact folder on your hard drive
  const folderPath = path.join(process.cwd(), 'public', project.data.turntable);
  
  // 2. Check if the folder actually exists to prevent crashes
  if (fs.existsSync(folderPath)) {
    
    // 3. Read the folder, filter out junk files (like .DS_Store), and keep only images
    const files = fs.readdirSync(folderPath)
      .filter(file => file.match(/\.(jpg|jpeg|png|webp)$/i))
      .sort(); // 4. Automatically sort them alphabetically (001, 002, 003...)

    // 5. Build the web URLs for the component
    generatedFrames = files.map(file => `${project.data.turntable}/${file}`);
  }
}
---

<Layout>
  <main class="max-w-5xl mx-auto px-6 py-12 md:py-20">
    
    <div class="mb-12">
      <h1 class="text-4xl md:text-5xl font-bold text-text-white mb-4 uppercase">{project.data.title}</h1>
      <div class="flex flex-wrap gap-4 text-sm tracking-widest text-brand-gold uppercase">
        <span>{project.data.category}</span>
        <span>•</span>
        <span>{project.data.role}</span>
        <span>•</span>
        <span>{project.data.client}</span>
      </div>
    </div>

    <div class="mb-16 rounded-md overflow-hidden shadow-2xl border border-cabilo-card relative aspect-video">
      {project.data.showreelUrl ? (
        <iframe class="absolute inset-0 w-full h-full pointer-events-none" src={`https://www.youtube.com/embed/${project.data.showreelUrl}?autoplay=1&mute=1&controls=0&modestbranding=1&rel=0&loop=1&playlist=${project.data.showreelUrl}`} frameborder="0" allow="autoplay; fullscreen" allowfullscreen></iframe>
      ) : (
        <img src={project.data.thumbnail} alt={project.data.title} class="absolute inset-0 w-full h-full object-cover" />
      )}
    </div>

    {project.data.aovPasses && project.data.aovPasses.length > 0 && (
      <div class="mb-20">
        <h3 class="text-xl text-text-white mb-6 uppercase tracking-wider">AOV Pass Inspector</h3>
        <DynamicAov passes={project.data.aovPasses} />
      </div>
    )}

    {generatedFrames.length > 0 && (
      <div class="mb-20">
        <h3 class="text-xl text-text-white mb-6 uppercase tracking-wider">360° Turntable</h3>
        <TurntableScrubber frames={generatedFrames} />
      </div>
    )}

    <div class="grid grid-cols-1 md:grid-cols-4 gap-12 border-t border-cabilo-card pt-12">
      <div class="md:col-span-3 prose prose-invert prose-p:text-text-silver prose-headings:text-text-white prose-a:text-brand-amber max-w-none">
        <h3 class="text-2xl font-medium mb-6 uppercase tracking-wide">Project Breakdown</h3>
        <Content />
      </div>
      <div class="md:col-span-1">
        <h4 class="text-xs uppercase tracking-widest text-text-white font-bold mb-4">Software Used</h4>
        <div class="flex flex-col gap-2">
          {project.data.softwareUsed.map((software) => (
            <span class="px-3 py-2 bg-cabilo-dark border border-cabilo-card rounded-md text-sm text-text-silver">{software}</span>
          ))}
        </div>
      </div>
    </div>

  </main>
</Layout>