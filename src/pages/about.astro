---
import Layout from '../layouts/Layout.astro';
---

<Layout>
  <main class="max-w-7xl mx-auto px-6 py-20">
    
    <!-- CHANGED: We now use a 12-column grid and massively increased the gap to lg:gap-24 -->
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-12 lg:gap-24 items-center">
      
      <!-- Left Column: Image (Takes up 5 out of 12 columns) -->
      <div class="lg:col-span-5 aspect-[4/5] bg-cabilo-dark border border-cabilo-card rounded-md overflow-hidden shadow-2xl relative">
        <!-- Changed to a more reliable Unsplash URL for now -->
        <img 
          src="https://images.unsplash.com/photo-1535295972055-1c762f4483e5?q=80&w=800&auto=format&fit=crop" 
          alt="CABILO Profile" 
          class="absolute inset-0 w-full h-full object-cover opacity-80"
        />
        <div class="absolute inset-0 bg-gradient-to-t from-cabilo-obsidian/90 via-transparent to-transparent"></div>
      </div>

      <!-- Right Column: Text & Skills (Takes up 7 out of 12 columns) -->
      <div class="lg:col-span-7 flex flex-col gap-8">
        
        <div class="flex flex-col gap-2">
          <h1 class="text-4xl md:text-5xl font-bold text-text-white uppercase tracking-wide">About CABILO</h1>
          <h2 class="text-lg text-brand-amber tracking-widest uppercase font-medium">Senior 3D Artist</h2>
        </div>
        
        <div class="text-text-silver flex flex-col gap-4 leading-relaxed text-lg">
          <p>
            With over a decade of experience, I specialize in crafting high-end cinematic realities, game cinematics, and complex Lookdev for the entertainment industry.
          </p>
          <p>
            My philosophy combines deep technical knowledge with a cinematic eye for lighting, composition, and storytelling.
          </p>
        </div>

        <div>
          <h3 class="text-text-white uppercase tracking-widest text-sm mb-4 font-bold">Software Arsenal</h3>
          <div class="flex flex-wrap gap-3">
            <span class="px-4 py-2 border border-cabilo-card rounded-md text-sm text-text-silver bg-cabilo-dark">Unreal Engine 5</span>
            <span class="px-4 py-2 border border-cabilo-card rounded-md text-sm text-text-silver bg-cabilo-dark">Maya</span>
            <span class="px-4 py-2 border border-cabilo-card rounded-md text-sm text-text-silver bg-cabilo-dark">Nuke</span>
            <span class="px-4 py-2 border border-cabilo-card rounded-md text-sm text-text-silver bg-cabilo-dark">ZBrush</span>
            <span class="px-4 py-2 border border-cabilo-card rounded-md text-sm text-text-silver bg-cabilo-dark">Substance Painter</span>
            <span class="px-4 py-2 border border-cabilo-card rounded-md text-sm text-text-silver bg-cabilo-dark">Houdini</span>
          </div>
        </div>

        <div class="mt-6">
          <a href="/CABILO_Resume.pdf" target="_blank" class="w-fit flex items-center justify-center gap-3 px-8 py-4 rounded-md bg-brand-amber text-text-white font-bold uppercase tracking-widest hover:bg-brand-gold transition-colors duration-300 shadow-lg hover:shadow-[0_0_20px_rgba(230,115,0,0.4)]">
            <svg class="w-5 h-5 shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 16v1a3 3 0 003 3h10a3 3 0 003-3v-1m-4-4l-4 4m0 0l-4-4m4 4V4"></path>
            </svg>
            <span>Download Resume</span>
          </a>
        </div>

      </div>

    </div>

  </main>
</Layout>