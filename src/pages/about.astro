---
import Layout from '../layouts/Layout.astro';
---

<Layout>
  <main class="max-w-7xl mx-auto px-6 py-20">
    
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-12 lg:gap-24 items-start">
      
      <!-- Left Column: Image -->
       <div class="lg:col-span-5 aspect-[4/5] bg-cabilo-dark border border-cabilo-card rounded-md overflow-hidden shadow-2xl relative lg:sticky lg:top-32">
        <img 
          src="https://images.unsplash.com/photo-1535295972055-1c762f4483e5?q=80&w=800&auto=format&fit=crop" 
          alt="CABILO Profile" 
          class="absolute inset-0 w-full h-full object-cover opacity-80"
        />
        <div class="absolute inset-0 bg-gradient-to-t from-cabilo-obsidian/90 via-transparent to-transparent"></div>
      </div>

      <!-- Right Column: Text & Skills -->
      <div class="lg:col-span-7 flex flex-col gap-10 pt-4">
        
        <div class="flex flex-col gap-2 border-b border-cabilo-card pb-8">
          <h1 class="text-4xl md:text-6xl font-bold text-text-white uppercase tracking-wide">About CABILO</h1>
          <h2 class="text-lg md:text-xl text-brand-amber tracking-widest uppercase font-medium">Senior 3D Artist</h2>
        </div>
        
        <div class="prose prose-invert prose-p:text-text-silver prose-lg max-w-none leading-relaxed">
          <p>
            With over a decade of experience, I specialize in crafting high-end cinematic realities, game cinematics, and complex Lookdev for the entertainment industry.
          </p>
          <p>
            My philosophy combines deep technical knowledge with a cinematic eye for lighting, composition, and storytelling. I believe that every asset, from the smallest mechanical joint to a full character groom, must be grounded in physical reality to truly sell the illusion.
          </p>
