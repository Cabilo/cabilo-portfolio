---
import Layout from '../layouts/Layout.astro';
// We import the brand new Ultimate Tool!
import DynamicAov from '../components/DynamicAov.astro';
---

<Layout>
  <main class="max-w-5xl mx-auto px-6 py-12">
    
    <!-- Project Header -->
    <div class="mb-12">
      <h1 class="text-4xl md:text-5xl font-bold text-text-white mb-4 uppercase">Sci-Fi Corridor</h1>
      <div class="flex gap-4 text-sm tracking-widest text-brand-gold uppercase">
        <span>Lookdev</span>
        <span>•</span>
        <span>Unreal Engine 5</span>
        <span>•</span>
        <span>Nuke</span>
      </div>
    </div>

    <!-- THE ULTIMATE DYNAMIC AOV TOOL -->
    <div class="mb-20">
      <h3 class="text-xl text-text-white mb-6 uppercase tracking-wider">AOV Inspector</h3>
      
      <!-- This drops your custom tool onto the page -->
      <DynamicAov />
      
    </div>

    <!-- Project Description -->
    <div class="prose prose-invert max-w-none text-text-silver border-t border-cabilo-card pt-10">
      <h3 class="text-text-white text-2xl font-medium mb-4">Project Breakdown</h3>
      <p>This is where you will write your breakdown of the project. You can explain your lighting setup, how you managed UVs, and your node setups in Nuke or Unreal.</p>
    </div>

  </main>
</Layout>