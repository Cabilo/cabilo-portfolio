---
import Layout from '../layouts/Layout.astro';
---

<Layout>
  <main class="flex flex-col items-center justify-center min-h-[70vh] px-6 text-center">
    
    <div class="relative mb-8">
      <h1 class="text-8xl md:text-9xl font-black text-cabilo-dark select-none">404</h1>
      <div class="absolute inset-0 flex items-center justify-center">
        <svg class="w-16 h-16 text-brand-amber animate-pulse" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-3L13.732 4c-.77-1.333-2.694-1.333-3.464 0L3.34 16c-.77 1.333.192 3 1.732 3z"></path></svg>
      </div>
    </div>

    <h2 class="text-2xl md:text-3xl font-bold text-text-white uppercase tracking-widest mb-4">
      Render Lost in <span class="text-brand-amber">Pipeline</span>
    </h2>
    
    <p class="text-text-silver max-w-md mx-auto mb-10">
      The page you are looking for has been moved, deleted, or never existed in this dimension.
    </p>

    <a href="/" class="px-8 py-4 rounded-md bg-brand-amber text-text-white font-bold uppercase tracking-widest hover:bg-brand-gold transition-colors duration-300 shadow-lg hover:shadow-[0_0_20px_rgba(230,115,0,0.4)]">
      Return to Studio
    </a>

  </main>
</Layout>