---
import { getCollection } from 'astro:content';
import LearningDetail from '../../components/LearningDetail.astro';

export async function getStaticPaths() {
  const learningDocs = await getCollection('learning');
  const tutorials = learningDocs.filter(doc => doc.data.type === 'Breakdown');

  return tutorials.map(doc => ({
    params: { id: doc.id },
    props: { doc },
  }));
}

const { doc } = Astro.props;
---

<LearningDetail doc={doc} />
