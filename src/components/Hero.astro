---
// src/components/Hero.astro
export interface Props {
  headline: string;
  subheadline?: string;
  showreelUrl?: string;
}

const { headline, subheadline, showreelUrl } = Astro.props;

const words = headline.split(' ');
const lastWord = words.pop();
const firstPart = words.join(' ');

// UNIVERSAL VIDEO PARSER
const getVideoEmbed = (url: string) => {
  if (!url) return null;
  try {
    const parsedUrl = new URL(url);
    const hostname = parsedUrl.hostname.replace(/^www\./, '');

    if (hostname === 'youtube.com' || hostname === 'm.youtube.com') {
      const videoId = parsedUrl.searchParams.get('v');
      if (videoId) return { type: 'youtube', src: `https://www.youtube.com/embed/${videoId}?autoplay=1&mute=1&controls=0&modestbranding=1&rel=0&loop=1&playlist=${videoId}` };
    }
    if (hostname === 'youtu.be') {
      const videoId = parsedUrl.pathname.replace('/', '');
      if (videoId) return { type: 'youtube', src: `https://www.youtube.com/embed/${videoId}?autoplay=1&mute=1&controls=0&modestbranding=1&rel=0&loop=1&playlist=${videoId}` };
    }
    if (hostname === 'vimeo.com') {
      const videoId = parsedUrl.pathname.split('/').filter(Boolean)[0];
      // Vimeo requires background=1 to loop silently without UI
      if (videoId) return { type: 'vimeo', src: `https://player.vimeo.com/video/${videoId}?background=1&autoplay=1&loop=1&muted=1` };
    }
    if (/\.(mp4|webm|ogg)(\?.*)?$/i.test(parsedUrl.pathname)) {
      return { type: 'direct', src: url };
    }
    return { type: 'unknown', src: url };
  } catch {
    // If it's not a valid URL, assume they just pasted a raw YouTube ID!
    return { type: 'youtube', src: `https://www.youtube.com/embed/${url}?autoplay=1&mute=1&controls=0&modestbranding=1&rel=0&loop=1&playlist=${url}` };
  }
};

const showreel = showreelUrl ? getVideoEmbed(showreelUrl) : null;
const locale = Astro.currentLocale === 'pt-br' ? 'pt-br' : 'en';
---

<section class="max-w-7xl mx-auto px-6 py-12 md:py-20 flex flex-col gap-10">
  <div class="flex flex-col items-center text-center max-w-3xl mx-auto">
    <h1 class="text-4xl md:text-6xl font-bold text-text-white tracking-wide mb-4 uppercase">
      {firstPart} <br/>
      <span class="bg-gradient-to-r from-brand-gold to-brand-amber bg-clip-text text-transparent">
        {lastWord}
      </span>
    </h1>
    
    <p class="text-lg text-text-silver mb-8">
      {subheadline}
    </p>
    
    <a href="#work" class="px-8 py-3 rounded-sm bg-brand-amber text-text-white font-bold uppercase tracking-widest hover:bg-brand-gold transition-colors duration-300">
      {locale === 'pt-br' ? 'Explorar Trabalhos' : 'Explore Work'}
    </a>
  </div>

  <div class="w-full relative aspect-video bg-cabilo-dark border border-cabilo-card rounded-md overflow-hidden shadow-[0_0_40px_rgba(230,115,0,0.1)]">
    {showreel && (
      showreel.type === 'youtube' || showreel.type === 'vimeo' ? (
        <iframe class="absolute inset-0 w-full h-full pointer-events-none" src={showreel.src} frameborder="0" allow="autoplay; fullscreen; picture-in-picture" allowfullscreen></iframe>
      ) : showreel.type === 'direct' ? (
        <video class="absolute inset-0 w-full h-full object-cover pointer-events-none" src={showreel.src} autoplay muted loop playsinline></video>
      ) : (
        <div class="absolute inset-0 flex flex-col items-center justify-center border border-dashed border-cabilo-card m-4">
          <span class="text-text-silver uppercase tracking-widest text-sm">Video URL not recognized</span>
        </div>
      )
    )}
  </div>
</section>