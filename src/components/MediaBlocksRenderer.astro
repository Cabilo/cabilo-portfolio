---
/**
 * src/components/MediaBlocksRenderer.astro
 *
 * Shared media-block rendering engine used by Projects,
 * Tutorials, and Breakdowns.
 */

import DynamicAov from './DynamicAov.astro';
import TurntableScrubber from './TurntableScrubber.astro';
import fs from 'node:fs';
import path from 'node:path';
import { parse } from 'marked';
import type { MediaBlock } from '../content.config';

export interface Props {
  blocks: MediaBlock[];
}

const { blocks } = Astro.props;

// ------------------------------------------------------------
// HELPER FUNCTIONS
// ------------------------------------------------------------

const getTurntableFrames = (folder: string) => {
  const folderPath = path.join(process.cwd(), 'public', folder);

  if (!fs.existsSync(folderPath)) return [];

  const files = fs.readdirSync(folderPath)
    .filter(file => /\.(jpg|jpeg|png|webp)$/i.test(file))
    .sort((a, b) => a.localeCompare(b, undefined, { numeric: true }));

  return files.map(file => `/${folder}/${file}`);
};

const getVideoEmbed = (url: string) => {
  if (!url) return null;

  try {
    const parsedUrl = new URL(url);
    const hostname = parsedUrl.hostname.replace(/^www\./, '');

    if (hostname === 'youtube.com' || hostname === 'm.youtube.com') {
      const videoId = parsedUrl.searchParams.get('v');

      if (videoId) {
        return {
          type: 'youtube',
          src: `https://www.youtube.com/embed/${videoId}?autoplay=1&mute=1&controls=1&modestbranding=1&rel=0`,
        };
      }
    }

    if (hostname === 'youtu.be') {
      const videoId = parsedUrl.pathname.replace('/', '');

      if (videoId) {
        return {
          type: 'youtube',
          src: `https://www.youtube.com/embed/${videoId}?autoplay=1&mute=1&controls=1&modestbranding=1&rel=0`,
        };
      }
    }

    if (hostname === 'vimeo.com') {
      const videoId = parsedUrl.pathname.split('/').filter(Boolean)[0];

      if (videoId) {
        return {
          type: 'vimeo',
          src: `https://player.vimeo.com/video/${videoId}?autoplay=1&muted=1`,
        };
      }
    }

    if (/\.(mp4|webm|ogg)(\?.*)?$/i.test(parsedUrl.pathname)) {
      return {
        type: 'direct',
        src: url,
      };
    }

    return {
      type: 'unknown',
      src: url,
    };
  } catch {
    return {
      type: 'youtube',
      src: `https://www.youtube.com/embed/${url}?autoplay=1&mute=1&controls=1&modestbranding=1&rel=0`,
    };
  }
};

// ------------------------------------------------------------
// ALIGNMENT HELPERS
// ------------------------------------------------------------

const getAlignmentClasses = (
  alignment: MediaBlock['titleAlign'],
  mediaType: MediaBlock['type'],
) => {
  switch (alignment) {
    case 'center':
      return 'w-full text-center';

    case 'page-left':
      return 'w-full text-left';

    case 'page-right':
      return 'w-full text-right';

    case 'media-left':
    default:
      /*
       * Images have a real intrinsic width, so this makes the
       * title/comment follow the actual media width instead of
       * the full page width.
       *
       * Video, turntable, and AOV blocks remain full-width here
       * because their interactive/rendering components manage
       * their own viewport sizing.
       */
      if (mediaType === 'image') {
        return 'w-fit max-w-full mx-auto text-left';
      }

      return 'w-full text-left';
  }
};
---

<!-- ====================================================== -->
<!-- THE MEDIA BLOCKS ENGINE -->
<!-- ====================================================== -->

{blocks.map((block) => {

  if (block.type === 'text_block') {
    const parsedHTML = parse(block.content) as string;

    return (
      <div class="mb-16">
        {block.title && (
          <h3 class="text-xl text-text-white mb-6 uppercase tracking-wider">
            {block.title}
          </h3>
        )}

        <div
          class="prose prose-invert prose-p:text-text-silver prose-headings:text-text-white prose-a:text-brand-amber max-w-none"
          set:html={parsedHTML}
        />
      </div>
    );
  }

  if (block.type === 'image') {
    return (
      <div class="mb-16">
        {block.title && (
          <h3
            class:list={[
              'text-xl text-text-white mb-6 uppercase tracking-wider',
              getAlignmentClasses(block.titleAlign, block.type),
            ]}
          >
            {block.title}
          </h3>
        )}

        <!--
          The frame is sized by the image itself.
          This prevents portrait images from creating a
          full-width frame while still keeping everything centered.
        -->
        <div class="flex justify-center w-full">
          <div
            class:list={[
              'inline-flex items-center justify-center rounded-md overflow-hidden shadow-2xl border border-cabilo-card',
              'max-w-full',
              block.fitToViewport && 'max-h-[75vh]',
            ]}
          >
            <img
              src={block.image}
              alt="Project Media"
              class:list={[
                'block object-contain object-center select-none',
                block.fitToViewport
                  ? 'max-w-full max-h-[75vh] w-auto h-auto'
                  : 'max-w-full w-auto h-auto',
              ]}
              loading="lazy"
              draggable="false"
            />
          </div>
        </div>

        {block.comment && (
          <p
            class:list={[
              'mt-4 text-sm leading-relaxed text-text-silver',
              getAlignmentClasses(block.commentAlign, block.type),
            ]}
          >
            {block.comment}
          </p>
        )}
      </div>
    );
  }

  if (block.type === 'video') {
    const video = getVideoEmbed(block.videoUrl);

    if (!video) return null;

    return (
      <div class="mb-16">
        {block.title && (
          <h3
            class:list={[
              'text-xl text-text-white mb-6 uppercase tracking-wider',
              getAlignmentClasses(block.titleAlign, block.type),
            ]}
          >
            {block.title}
          </h3>
        )}

        <div class="rounded-md overflow-hidden shadow-2xl border border-cabilo-card relative aspect-video w-full">
          {video.type === 'youtube' || video.type === 'vimeo' ? (
            <iframe
              class="absolute inset-0 w-full h-full"
              src={video.src}
              frameborder="0"
              loading="lazy"
              allow="autoplay; fullscreen; picture-in-picture"
              allowfullscreen
            ></iframe>
          ) : video.type === 'direct' ? (
            <video
              class="absolute inset-0 w-full h-full object-contain bg-black"
              src={video.src}
              controls
              preload="metadata"
              playsinline
            ></video>
          ) : (
            <div class="absolute inset-0 flex items-center justify-center bg-cabilo-dark p-8">
              <p class="text-text-silver">
                Video URL not recognized.
              </p>
            </div>
          )}
        </div>

        {block.comment && (
          <p
            class:list={[
              'mt-4 text-sm leading-relaxed text-text-silver',
              getAlignmentClasses(block.commentAlign, block.type),
            ]}
          >
            {block.comment}
          </p>
        )}
      </div>
    );
  }

  if (block.type === 'turntable') {
    const frames = getTurntableFrames(block.folder);

    if (frames.length === 0) return null;

    return (
      <div class="mb-20">
        {block.title && (
          <h3
            class:list={[
              'text-xl text-text-white mb-6 uppercase tracking-wider',
              getAlignmentClasses(block.titleAlign, block.type),
            ]}
          >
            {block.title}
          </h3>
        )}

        <TurntableScrubber
          frames={frames}
          fitToViewport={block.fitToViewport}
        />

        {block.comment && (
          <p
            class:list={[
              'mt-4 text-sm leading-relaxed text-text-silver',
              getAlignmentClasses(block.commentAlign, block.type),
            ]}
          >
            {block.comment}
          </p>
        )}
      </div>
    );
  }

  if (block.type === 'aov') {
    if (!block.aovPasses || block.aovPasses.length === 0) return null;

    return (
      <div class="mb-20">
        {block.title && (
          <h3
            class:list={[
              'text-xl text-text-white mb-6 uppercase tracking-wider',
              getAlignmentClasses(block.titleAlign, block.type),
            ]}
          >
            {block.title}
          </h3>
        )}

        <DynamicAov
          passes={block.aovPasses}
          fitToViewport={block.fitToViewport}
        />

        {block.comment && (
          <p
            class:list={[
              'mt-4 text-sm leading-relaxed text-text-silver',
              getAlignmentClasses(block.commentAlign, block.type),
            ]}
          >
            {block.comment}
          </p>
        )}
      </div>
    );
  }

  return null;
})}