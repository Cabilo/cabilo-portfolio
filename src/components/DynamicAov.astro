---
interface AovPass {
  name: string;
  image: string;
}

interface Props {
  passes: AovPass[];
  fitToViewport?: boolean;
}

const {
  passes,
  fitToViewport = true,
} = Astro.props;

const imageA = passes[0]?.image;
const imageB = passes[1]?.image;
---

{imageA && imageB && (
  <dynamic-aov
    data-image-a={imageA}
    data-image-b={imageB}
    data-fit-viewport={String(fitToViewport)}
    class="flex justify-center w-full"
  >
    <div
      id="aov-container"
      class="relative mx-auto bg-cabilo-obsidian overflow-hidden ring-1 ring-cabilo-card shadow-lg select-none"
      style="touch-action: pan-y;"
    >
      <img
        id="aov-image-a"
        src={imageA}
        alt={passes[0]?.name || 'AOV pass A'}
        class="absolute inset-0 block pointer-events-none select-none object-contain object-center"
        draggable="false"
      />

      <div
        id="aov-clip"
        class="absolute inset-y-0 left-0 overflow-hidden pointer-events-none"
        style="width: 50%;"
      >
        <img
          id="aov-image-b"
          src={imageB}
          alt={passes[1]?.name || 'AOV pass B'}
          class="absolute top-0 left-0 block pointer-events-none select-none object-contain object-center"
          draggable="false"
        />
      </div>

      <div
        id="aov-divider"
        class="absolute top-0 bottom-0 left-1/2 -translate-x-1/2 w-px bg-white/80 pointer-events-none"
      ></div>

      <input
        id="aov-slider"
        type="range"
        min="0"
        max="100"
        value="50"
        class="absolute inset-0 w-full h-full opacity-0 cursor-ew-resize"
        aria-label="AOV comparison slider"
      />
    </div>
  </dynamic-aov>
)}

<script>
  class DynamicAov extends HTMLElement {
    private container!: HTMLElement;
    private imageA!: HTMLImageElement;
    private imageB!: HTMLImageElement;
    private clip!: HTMLElement;
    private divider!: HTMLElement;
    private slider!: HTMLInputElement;

    private fitToViewport = true;

    private dragging = false;
    private touchStartedInside = false;
    private touchDirectionLocked = false;
    private touchCancelled = false;
    private touchStartX = 0;
    private touchStartY = 0;

    connectedCallback() {
      this.container = this.querySelector('#aov-container') as HTMLElement;
      this.imageA = this.querySelector('#aov-image-a') as HTMLImageElement;
      this.imageB = this.querySelector('#aov-image-b') as HTMLImageElement;
      this.clip = this.querySelector('#aov-clip') as HTMLElement;
      this.divider = this.querySelector('#aov-divider') as HTMLElement;
      this.slider = this.querySelector('#aov-slider') as HTMLInputElement;

      this.fitToViewport =
        this.dataset.fitViewport !== 'false';

      if (!this.container || !this.imageA || !this.imageB) {
        return;
      }

      this.bindEvents();

      if (this.imageA.complete) {
        this.fixImageSize();
      } else {
        this.imageA.addEventListener(
          'load',
          this.fixImageSize,
          { once: true },
        );
      }

      window.addEventListener('resize', this.fixImageSize);
    }

    disconnectedCallback() {
      window.removeEventListener('resize', this.fixImageSize);
    }

    private bindEvents() {
      this.slider.addEventListener('input', () => {
        this.updatePosition(Number(this.slider.value));
      });

      this.container.addEventListener(
        'mousedown',
        this.onMouseDown,
      );

      window.addEventListener(
        'mousemove',
        this.onMouseMove,
      );

      window.addEventListener(
        'mouseup',
        this.onMouseUp,
      );

      this.container.addEventListener(
        'touchstart',
        this.onTouchStart,
        { passive: true },
      );

      window.addEventListener(
        'touchmove',
        this.onTouchMove,
        { passive: false },
      );

      window.addEventListener(
        'touchend',
        this.onTouchEnd,
        { passive: true },
      );
    }

    private fixImageSize = () => {
      if (
        !this.imageA.naturalWidth ||
        !this.imageA.naturalHeight
      ) {
        return;
      }

      const naturalWidth = this.imageA.naturalWidth;
      const naturalHeight = this.imageA.naturalHeight;

      const parentWidth =
        this.parentElement?.clientWidth ||
        window.innerWidth;

      const availableWidth = Math.min(
        parentWidth,
        window.innerWidth,
      );

      const maxHeight = this.fitToViewport
        ? window.innerHeight * 0.75
        : Infinity;

      const scale = Math.min(
        1,
        availableWidth / naturalWidth,
        maxHeight / naturalHeight,
      );

      const width = Math.round(naturalWidth * scale);
      const height = Math.round(naturalHeight * scale);

      /*
       * Frame = content.
       * No extra full-width wrapper.
       */
      this.container.style.width = `${width}px`;
      this.container.style.height = `${height}px`;

      this.imageA.style.width = `${width}px`;
      this.imageA.style.height = `${height}px`;

      this.imageB.style.width = `${width}px`;
      this.imageB.style.height = `${height}px`;

      this.updatePosition(Number(this.slider.value));
    };

    private updatePosition(value: number) {
      const clamped = Math.max(
        0,
        Math.min(100, value),
      );

      this.clip.style.width = `${clamped}%`;
      this.divider.style.left = `${clamped}%`;
    }

    private onMouseDown = (event: MouseEvent) => {
      this.dragging = true;
      this.updateFromPointer(event.clientX);
    };

    private onMouseMove = (event: MouseEvent) => {
      if (!this.dragging) return;

      this.updateFromPointer(event.clientX);
    };

    private onMouseUp = () => {
      this.dragging = false;
    };

    private onTouchStart = (event: TouchEvent) => {
      if (!event.touches.length) return;

      const touch = event.touches[0];
      const rect =
        this.container.getBoundingClientRect();

      this.touchStartedInside =
        touch.clientX >= rect.left &&
        touch.clientX <= rect.right &&
        touch.clientY >= rect.top &&
        touch.clientY <= rect.bottom;

      this.touchDirectionLocked = false;
      this.touchCancelled = false;

      if (!this.touchStartedInside) return;

      this.touchStartX = touch.clientX;
      this.touchStartY = touch.clientY;
    };

    private onTouchMove = (event: TouchEvent) => {
      if (!this.touchStartedInside) return;
      if (this.touchCancelled) return;
      if (!event.touches.length) return;

      const touch = event.touches[0];

      const deltaX =
        touch.clientX - this.touchStartX;

      const deltaY =
        touch.clientY - this.touchStartY;

      if (!this.touchDirectionLocked) {
        if (
          Math.abs(deltaX) < 8 &&
          Math.abs(deltaY) < 8
        ) {
          return;
        }

        this.touchDirectionLocked = true;

        if (Math.abs(deltaY) > Math.abs(deltaX)) {
          this.touchCancelled = true;
          return;
        }
      }

      event.preventDefault();

      this.updateFromPointer(touch.clientX);
    };

    private onTouchEnd = () => {
      this.touchStartedInside = false;
      this.touchDirectionLocked = false;
      this.touchCancelled = false;
    };

    private updateFromPointer(clientX: number) {
      const rect =
        this.container.getBoundingClientRect();

      if (!rect.width) return;

      const position =
        ((clientX - rect.left) / rect.width) * 100;

      const clamped = Math.max(
        0,
        Math.min(100, position),
      );

      this.slider.value = String(clamped);
      this.updatePosition(clamped);
    };
  }

  if (!customElements.get('dynamic-aov')) {
    customElements.define('dynamic-aov', DynamicAov);
  }
</script>