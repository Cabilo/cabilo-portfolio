---
/**
 * src/components/DynamicAov.astro
 *
 * Reusable AOV comparison viewer.
 *
 * UX rules:
 * - The comparison viewport can be capped at 75vh.
 * - Both images always occupy the same fixed viewport dimensions.
 * - The B image is translated underneath the clipper instead of being resized
 *   when the comparison slider moves.
 * - Horizontal touch gestures control the slider.
 * - Once the slider handle is grabbed, pointer capture keeps the gesture active
 *   while the finger moves anywhere inside the AOV frame.
 * - While dragging, browser text/image selection is temporarily disabled.
 * - Vertical page scrolling remains available when the user starts a fresh gesture.
 */

export interface Props {
  passes: {
    name: string;
    image: string;
  }[];
  fitToViewport?: boolean;
}

const {
  passes,
  fitToViewport = true,
} = Astro.props;

const defaultA = passes[0];
const defaultB = passes.length > 1 ? passes[1] : passes[0];
---

<dynamic-aov
  class:list={['block w-full', !fitToViewport && 'h-full']}
  data-fit-viewport={fitToViewport ? 'true' : 'false'}
>
  <div class:list={['flex flex-col gap-6', !fitToViewport && 'h-full']}>

    <div
      class:list={[
        'aov-container relative overflow-hidden max-w-full mx-auto bg-cabilo-obsidian',
        !fitToViewport && 'h-full',
      ]}
      style="touch-action: pan-y;"
    >

      <!-- A IMAGE -->
      <img
        src={defaultA.image}
        alt="Side A"
        class="img-a absolute inset-0 w-full h-full object-contain object-center select-none pointer-events-none"
        draggable="false"
      />

      <!-- B IMAGE / CLIPPER -->
      <div
        class="clipper-b absolute inset-y-0 right-0 border-l-2 border-brand-amber overflow-hidden"
        style="width: 50%; left: 50%;"
      >
        <img
          src={defaultB.image}
          alt="Side B"
          class="img-b absolute top-0 w-full h-full max-w-none object-contain object-center select-none pointer-events-none"
          style="left: -50%;"
          draggable="false"
        />
      </div>

      <!-- SLIDER -->
      <div
        class="aov-slider absolute top-0 bottom-0 w-12 cursor-ew-resize flex items-center justify-center z-20 group"
        style="left: 50%; transform: translateX(-50%); touch-action: none;"
      >
        <div class="absolute inset-y-0 left-1/2 -translate-x-1/2 w-0.5 bg-brand-amber"></div>

        <div class="relative w-10 h-10 bg-brand-amber rounded-full shadow-[0_0_15px_rgba(230,115,0,0.8)] flex items-center justify-center pointer-events-none">
          <div class="flex items-center gap-1 text-cabilo-obsidian">
            <svg
              class="w-4 h-4"
              fill="none"
              stroke="currentColor"
              viewBox="0 0 24 24"
            >
              <path
                stroke-linecap="round"
                stroke-linejoin="round"
                stroke-width="3"
                d="M15 19l-7-7 7-7"
              ></path>
            </svg>

            <svg
              class="w-4 h-4"
              fill="none"
              stroke="currentColor"
              viewBox="0 0 24 24"
            >
              <path
                stroke-linecap="round"
                stroke-linejoin="round"
                stroke-width="3"
                d="M9 5l7 7-7 7"
              ></path>
            </svg>
          </div>
        </div>
      </div>

      <!-- LABELS -->
      <div class="label-a absolute bottom-4 left-4 bg-cabilo-obsidian/80 backdrop-blur-sm px-3 py-1 rounded text-xs tracking-widest text-text-white uppercase pointer-events-none z-10">
        {defaultA.name}
      </div>

      <div class="label-b absolute bottom-4 right-4 bg-cabilo-obsidian/80 backdrop-blur-sm px-3 py-1 rounded text-xs tracking-widest text-text-white uppercase pointer-events-none z-10">
        {defaultB.name}
      </div>
    </div>

    <!-- AOV PASS SELECTORS -->
    <div class="grid grid-cols-1 md:grid-cols-2 gap-8 bg-cabilo-dark p-6 rounded-md border border-cabilo-card">

      <div>
        <h4 class="text-text-silver text-xs tracking-widest uppercase mb-3">
          Left Side (A)
        </h4>

        <div class="flex flex-wrap gap-2">
          {passes.map((pass, index) => (
            <button
              class:list={[
                'btn-a px-3 py-1.5 rounded-md text-xs font-bold tracking-wider uppercase transition-colors',
                index === 0
                  ? 'bg-brand-amber text-text-white'
                  : 'bg-cabilo-card text-text-silver hover:text-text-white',
              ]}
              data-name={pass.name}
              data-image={pass.image}
              type="button"
            >
              {pass.name}
            </button>
          ))}
        </div>
      </div>

      <div>
        <h4 class="text-text-silver text-xs tracking-widest uppercase mb-3">
          Right Side (B)
        </h4>

        <div class="flex flex-wrap gap-2">
          {passes.map((pass, index) => (
            <button
              class:list={[
                'btn-b px-3 py-1.5 rounded-md text-xs font-bold tracking-wider uppercase transition-colors',
                index === 1
                  ? 'bg-brand-amber text-text-white'
                  : 'bg-cabilo-card text-text-silver hover:text-text-white',
              ]}
              data-name={pass.name}
              data-image={pass.image}
              type="button"
            >
              {pass.name}
            </button>
          ))}
        </div>
      </div>

    </div>
  </div>
</dynamic-aov>

<script>
  class DynamicAov extends HTMLElement {
    connectedCallback() {
      if (this.dataset.initialized === 'true') return;

      this.dataset.initialized = 'true';

      const container = this.querySelector('.aov-container') as HTMLElement;
      const clipperB = this.querySelector('.clipper-b') as HTMLElement;
      const slider = this.querySelector('.aov-slider') as HTMLElement;
      const imgA = this.querySelector('.img-a') as HTMLImageElement;
      const imgB = this.querySelector('.img-b') as HTMLImageElement;
      const labelA = this.querySelector('.label-a') as HTMLElement;
      const labelB = this.querySelector('.label-b') as HTMLElement;
      const buttonsA = this.querySelectorAll('.btn-a');
      const buttonsB = this.querySelectorAll('.btn-b');

      if (!container || !clipperB || !slider || !imgA || !imgB) return;

      const fitViewport = this.dataset.fitViewport === 'true';

      let isDragging = false;
      let activePointerId: number | null = null;
      let sliderPosition = 50;

      const originalUserSelect = document.body.style.userSelect;

      const disableSelection = () => {
        document.body.style.userSelect = 'none';
        document.body.style.webkitUserSelect = 'none';
      };

      const restoreSelection = () => {
        document.body.style.userSelect = originalUserSelect;
        document.body.style.webkitUserSelect = originalUserSelect;
      };

      const applySliderPosition = () => {
        const rect = container.getBoundingClientRect();

        if (!rect.width) return;

        const position = Math.max(0, Math.min(100, sliderPosition));
        const offset = rect.width * (position / 100);

        slider.style.left = `${position}%`;

        clipperB.style.width = `${100 - position}%`;
        clipperB.style.left = `${position}%`;

        /*
         * The B image is inside the clipper, so its left edge must be
         * offset by the slider position relative to the FULL viewport.
         */
        imgB.style.left = `-${offset}px`;
      };

      const fitImageToViewport = () => {
        if (!imgA.naturalWidth || !imgA.naturalHeight) return;

        const aspectRatio = imgA.naturalWidth / imgA.naturalHeight;
        const availableWidth = this.clientWidth;

        if (!availableWidth) return;

        if (!fitViewport) {
          container.style.width = '';
          container.style.height = '';
          imgA.style.width = '';
          imgA.style.height = '';
          imgB.style.width = '';
          imgB.style.height = '';

          requestAnimationFrame(() => {
            applySliderPosition();
          });

          return;
        }

        const availableHeight = window.innerHeight * 0.75;
        const widthFromHeight = availableHeight * aspectRatio;
        const width = Math.min(availableWidth, widthFromHeight);
        const height = width / aspectRatio;

        container.style.width = `${width}px`;
        container.style.height = `${height}px`;

        imgA.style.width = `${width}px`;
        imgA.style.height = `${height}px`;

        imgB.style.width = `${width}px`;
        imgB.style.height = `${height}px`;

        requestAnimationFrame(() => {
          applySliderPosition();
        });
      };

      imgA.addEventListener('load', fitImageToViewport);
      imgB.addEventListener('load', fitImageToViewport);
      window.addEventListener('resize', fitImageToViewport);

      fitImageToViewport();

      const updateSlider = (clientX: number) => {
        const rect = container.getBoundingClientRect();

        if (!rect.width) return;

        sliderPosition = ((clientX - rect.left) / rect.width) * 100;
        sliderPosition = Math.max(0, Math.min(100, sliderPosition));

        applySliderPosition();
      };

      /*
       * Pointer events are used instead of separate mouse/touch events.
       *
       * Once the user grabs the slider, pointer capture keeps sending
       * pointer movements to the slider even if the pointer moves away
       * from the small circle.
       */
      slider.addEventListener('pointerdown', (e) => {
        if (e.pointerType === 'mouse' && e.button !== 0) return;

        isDragging = true;
        activePointerId = e.pointerId;

        /*
         * Prevent accidental browser text/image selection while the
         * handle is actively being dragged.
         */
        disableSelection();

        /*
         * Keep ownership of this pointer even when the mouse/finger
         * moves outside the handle.
         */
        slider.setPointerCapture(e.pointerId);

        updateSlider(e.clientX);

        e.preventDefault();
      });

      slider.addEventListener('pointermove', (e) => {
        if (!isDragging) return;
        if (activePointerId !== e.pointerId) return;

        updateSlider(e.clientX);

        /*
         * Prevent the browser from interpreting the drag as a
         * selection gesture.
         */
        e.preventDefault();
      });

      const endPointerDrag = (e: PointerEvent) => {
        if (activePointerId !== e.pointerId) return;

        isDragging = false;

        /*
         * Selection is enabled again as soon as the handle is released.
         */
        restoreSelection();

        if (slider.hasPointerCapture(e.pointerId)) {
          slider.releasePointerCapture(e.pointerId);
        }

        activePointerId = null;
      };

      slider.addEventListener('pointerup', endPointerDrag);
      slider.addEventListener('pointercancel', endPointerDrag);

      slider.addEventListener('lostpointercapture', () => {
        if (isDragging) {
          isDragging = false;
          restoreSelection();
        }

        activePointerId = null;
      });

      buttonsA.forEach((btn) => {
        btn.addEventListener('click', (e) => {
          const target = e.currentTarget as HTMLButtonElement;
          const image = target.getAttribute('data-image') || '';
          const name = target.getAttribute('data-name') || '';

          imgA.src = image;
          labelA.innerText = name;

          buttonsA.forEach((button) => {
            button.classList.remove('bg-brand-amber', 'text-text-white');
            button.classList.add('bg-cabilo-card', 'text-text-silver');
          });

          target.classList.remove('bg-cabilo-card', 'text-text-silver');
          target.classList.add('bg-brand-amber', 'text-text-white');
        });
      });

      buttonsB.forEach((btn) => {
        btn.addEventListener('click', (e) => {
          const target = e.currentTarget as HTMLButtonElement;
          const image = target.getAttribute('data-image') || '';
          const name = target.getAttribute('data-name') || '';

          imgB.src = image;
          labelB.innerText = name;

          fitImageToViewport();

          buttonsB.forEach((button) => {
            button.classList.remove('bg-brand-amber', 'text-text-white');
            button.classList.add('bg-cabilo-card', 'text-text-silver');
          });

          target.classList.remove('bg-cabilo-card', 'text-text-silver');
          target.classList.add('bg-brand-amber', 'text-text-white');
        });
      });
    }
  }

  customElements.define('dynamic-aov', DynamicAov);
</script>