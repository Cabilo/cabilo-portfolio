---
/**
 * src/components/DynamicAov.astro
 *
 * Reusable AOV comparison viewer.
 *
 * UX rules:
 * - The comparison viewport can be capped at 75vh.
 * - Both images always occupy the same fixed viewport dimensions.
 * - The B image is translated underneath the clipper instead of being resized
 *   when the comparison slider moves.
 * - Horizontal touch gestures control the slider.
 * - Once the slider handle is grabbed, pointer capture keeps the gesture active
 *   while the finger moves anywhere inside the AOV frame.
 * - While dragging, browser text/image selection is temporarily disabled.
 * - Vertical page scrolling remains available when the user starts a fresh gesture.
 * - AOV pass selection stays inside the comparison viewport as compact dropdown controls.
 */

import { getOptimizedImagePath } from '../lib/images';

export interface Props {
  passes: {
    name: string;
    image: string;
  }[];
  fitToViewport?: boolean;
  compress?: boolean;
  /**
   * Layout Blocks mode: the comparison viewport follows the
   * first AOV asset's aspect ratio while the pass selectors
   * remain in normal document flow below it.
   */
  fitToLayoutAspect?: boolean;
}

const {
  passes,
  fitToViewport = true,
  compress = true,
  fitToLayoutAspect = false,
} = Astro.props;

const optimizedPasses = passes.map((pass) => ({
  ...pass,
  image: getOptimizedImagePath(pass.image, compress),
}));

const defaultA = optimizedPasses[0];
const defaultB = optimizedPasses.length > 1 ? optimizedPasses[1] : optimizedPasses[0];
---

<dynamic-aov
  class:list={[
    'block w-full',
    !fitToViewport && !fitToLayoutAspect && 'h-full min-h-0',
  ]}
  data-fit-viewport={fitToViewport ? 'true' : 'false'}
  data-fit-layout-aspect={fitToLayoutAspect ? 'true' : 'false'}
>
  <div class:list={['flex flex-col gap-6', !fitToViewport && !fitToLayoutAspect && 'h-full min-h-0']}>

    <div
      class:list={[
        'aov-container relative overflow-hidden max-w-full mx-auto bg-cabilo-obsidian',
        !fitToViewport && !fitToLayoutAspect && 'flex-1 min-h-0',
        fitToLayoutAspect && 'flex-none w-full',
      ]}
      style="touch-action: pan-y;"
    >

      <!-- A IMAGE -->
      <img
        src={defaultA.image}
        alt="Side A"
        class="img-a absolute inset-0 w-full h-full object-contain object-center select-none pointer-events-none"
        draggable="false"
      />

      <!-- B IMAGE / CLIPPER -->
      <div
        class="clipper-b absolute inset-y-0 right-0 border-l-2 border-brand-amber overflow-hidden"
        style="width: 50%; left: 50%;"
      >
        <img
          src={defaultB.image}
          alt="Side B"
          class="img-b absolute top-0 w-full h-full max-w-none object-contain object-center select-none pointer-events-none"
          style="left: -50%;"
          draggable="false"
        />
      </div>

      <!-- SLIDER -->
      <div
        class="aov-slider absolute top-0 bottom-0 w-12 cursor-ew-resize flex items-center justify-center z-20 group"
        style="left: 50%; transform: translateX(-50%); touch-action: none;"
      >
        <div class="absolute inset-y-0 left-1/2 -translate-x-1/2 w-0.5 bg-brand-amber"></div>

        <div class="relative w-10 h-10 bg-brand-amber rounded-full shadow-[0_0_15px_rgba(230,115,0,0.8)] flex items-center justify-center pointer-events-none">
          <div class="flex items-center gap-1 text-cabilo-obsidian">
            <svg
              class="w-4 h-4"
              fill="none"
              stroke="currentColor"
              viewBox="0 0 24 24"
            >
              <path
                stroke-linecap="round"
                stroke-linejoin="round"
                stroke-width="3"
                d="M15 19l-7-7 7-7"
              ></path>
            </svg>

            <svg
              class="w-4 h-4"
              fill="none"
              stroke="currentColor"
              viewBox="0 0 24 24"
            >
              <path
                stroke-linecap="round"
                stroke-linejoin="round"
                stroke-width="3"
                d="M9 5l7 7-7 7"
              ></path>
            </svg>
          </div>
        </div>
      </div>

      <!-- AOV PASS SELECTORS -->
      <div class="aov-pass-select aov-pass-select-a absolute bottom-4 left-4 z-30">
        <label class="sr-only" for="aov-pass-a">Choose left AOV pass</label>
        <select
          id="aov-pass-a"
          class="aov-pass-select-control"
          aria-label="Choose left AOV pass"
        >
          {optimizedPasses.map((pass, index) => (
            <option value={index} data-image={pass.image} data-name={pass.name}>{pass.name}</option>
          ))}
        </select>
        <svg
          class="aov-pass-select-chevron pointer-events-none absolute right-3 top-1/2 -translate-y-1/2 w-3.5 h-3.5 text-text-silver"
          fill="none"
          stroke="currentColor"
          viewBox="0 0 24 24"
          aria-hidden="true"
        >
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="m6 9 6 6 6-6"></path>
        </svg>
      </div>

      <div class="aov-pass-select aov-pass-select-b absolute bottom-4 right-4 z-30">
        <label class="sr-only" for="aov-pass-b">Choose right AOV pass</label>
        <select
          id="aov-pass-b"
          class="aov-pass-select-control"
          aria-label="Choose right AOV pass"
        >
          {optimizedPasses.map((pass, index) => (
            <option
            value={index}
            data-image={pass.image}
            data-name={pass.name}
            selected={index === 1 || (passes.length === 1 && index === 0)}
          >
            {pass.name}
          </option>
          ))}
        </select>
        <svg
          class="aov-pass-select-chevron pointer-events-none absolute right-3 top-1/2 -translate-y-1/2 w-3.5 h-3.5 text-text-silver"
          fill="none"
          stroke="currentColor"
          viewBox="0 0 24 24"
          aria-hidden="true"
        >
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="m6 9 6 6 6-6"></path>
        </svg>
      </div>
    </div>
  </div>
</dynamic-aov>

<script>
  class DynamicAov extends HTMLElement {
    connectedCallback() {
      if (this.dataset.initialized === 'true') return;

      this.dataset.initialized = 'true';

      const container = this.querySelector('.aov-container') as HTMLElement;
      const clipperB = this.querySelector('.clipper-b') as HTMLElement;
      const slider = this.querySelector('.aov-slider') as HTMLElement;
      const imgA = this.querySelector('.img-a') as HTMLImageElement;
      const imgB = this.querySelector('.img-b') as HTMLImageElement;
      const selectA = this.querySelector('.aov-pass-select-a select') as HTMLSelectElement;
      const selectB = this.querySelector('.aov-pass-select-b select') as HTMLSelectElement;

      if (!container || !clipperB || !slider || !imgA || !imgB) return;

      const fitViewport = this.dataset.fitViewport === 'true';
      const fitLayoutAspect = this.dataset.fitLayoutAspect === 'true';

      let isDragging = false;
      let activePointerId: number | null = null;
      let sliderPosition = 50;

      const originalUserSelect = document.body.style.userSelect;

      const disableSelection = () => {
        document.body.style.userSelect = 'none';
        document.body.style.webkitUserSelect = 'none';
      };

      const restoreSelection = () => {
        document.body.style.userSelect = originalUserSelect;
        document.body.style.webkitUserSelect = originalUserSelect;
      };

      const applySliderPosition = () => {
        const rect = container.getBoundingClientRect();

        if (!rect.width) return;

        const position = Math.max(0, Math.min(100, sliderPosition));
        const offset = rect.width * (position / 100);

        slider.style.left = `${position}%`;

        clipperB.style.width = `${100 - position}%`;
        clipperB.style.left = `${position}%`;

        /*
         * The B image is inside the clipper, so its left edge must be
         * offset by the slider position relative to the FULL viewport.
         */
        imgB.style.left = `-${offset}px`;
      };

      const fitImageToViewport = () => {
        if (!imgA.naturalWidth || !imgA.naturalHeight) return;

        const aspectRatio = imgA.naturalWidth / imgA.naturalHeight;
        const availableWidth = this.clientWidth;

        if (!availableWidth) return;

        if (!fitViewport) {
          const width = container.clientWidth;

          if (!width) return;

          if (fitLayoutAspect) {
            const height = width / aspectRatio;

            container.style.width = '100%';
            container.style.height = `${height}px`;

            imgA.style.width = `${width}px`;
            imgA.style.height = `${height}px`;
            imgB.style.width = `${width}px`;
            imgB.style.height = `${height}px`;
          } else {
            const height = container.clientHeight;

            if (!height) return;

            container.style.width = '100%';
            container.style.height = '100%';

            imgA.style.width = `${width}px`;
            imgA.style.height = `${height}px`;
            imgB.style.width = `${width}px`;
            imgB.style.height = `${height}px`;
          }

          requestAnimationFrame(() => {
            applySliderPosition();
          });

          return;
        }

        const availableHeight = window.innerHeight * 0.75;
        const widthFromHeight = availableHeight * aspectRatio;
        const width = Math.min(availableWidth, widthFromHeight);
        const height = width / aspectRatio;

        container.style.width = `${width}px`;
        container.style.height = `${height}px`;

        imgA.style.width = `${width}px`;
        imgA.style.height = `${height}px`;

        imgB.style.width = `${width}px`;
        imgB.style.height = `${height}px`;

        requestAnimationFrame(() => {
          applySliderPosition();
        });
      };

      imgA.addEventListener('load', fitImageToViewport);
      imgB.addEventListener('load', fitImageToViewport);
      window.addEventListener('resize', fitImageToViewport);

      /*
       * Layout Blocks can resize the AOV container without resizing the
       * browser window. When that happens, the AOV images need to be
       * recalculated against the new container dimensions.
       */
      const containerResizeObserver = !fitViewport && typeof ResizeObserver !== 'undefined'
        ? new ResizeObserver(() => {
            fitImageToViewport();
          })
        : null;

      containerResizeObserver?.observe(container);

      fitImageToViewport();

      const updateSlider = (clientX: number) => {
        const rect = container.getBoundingClientRect();

        if (!rect.width) return;

        sliderPosition = ((clientX - rect.left) / rect.width) * 100;
        sliderPosition = Math.max(0, Math.min(100, sliderPosition));

        applySliderPosition();
      };

      /*
       * Pointer events are used instead of separate mouse/touch events.
       *
       * Once the user grabs the slider, pointer capture keeps sending
       * pointer movements to the slider even if the pointer moves away
       * from the small circle.
       */
      slider.addEventListener('pointerdown', (e) => {
        if (e.pointerType === 'mouse' && e.button !== 0) return;

        isDragging = true;
        activePointerId = e.pointerId;

        /*
         * Prevent accidental browser text/image selection while the
         * handle is actively being dragged.
         */
        disableSelection();

        /*
         * Keep ownership of this pointer even when the mouse/finger
         * moves outside the handle.
         */
        slider.setPointerCapture(e.pointerId);

        updateSlider(e.clientX);

        e.preventDefault();
      });

      slider.addEventListener('pointermove', (e) => {
        if (!isDragging) return;
        if (activePointerId !== e.pointerId) return;

        updateSlider(e.clientX);

        /*
         * Prevent the browser from interpreting the drag as a
         * selection gesture.
         */
        e.preventDefault();
      });

      const endPointerDrag = (e: PointerEvent) => {
        if (activePointerId !== e.pointerId) return;

        isDragging = false;

        /*
         * Selection is enabled again as soon as the handle is released.
         */
        restoreSelection();

        if (slider.hasPointerCapture(e.pointerId)) {
          slider.releasePointerCapture(e.pointerId);
        }

        activePointerId = null;
      };

      slider.addEventListener('pointerup', endPointerDrag);
      slider.addEventListener('pointercancel', endPointerDrag);

      slider.addEventListener('lostpointercapture', () => {
        if (isDragging) {
          isDragging = false;
          restoreSelection();
        }

        activePointerId = null;
      });

      const getSelectedPass = (select: HTMLSelectElement) => {
        const option = select.options[select.selectedIndex];

        if (!option) return null;

        return {
          image: option.getAttribute('data-image') || '',
          name: option.getAttribute('data-name') || option.textContent?.trim() || '',
        };
      };

      const updatePassA = () => {
        const pass = getSelectedPass(selectA);

        if (!pass?.image) return;

        imgA.src = pass.image;
        imgA.alt = pass.name;

        /*
         * The A image defines the Layout Blocks comparison aspect ratio,
         * so recalculate the viewport once the new image is available.
         */
        if (imgA.complete) {
          fitImageToViewport();
        }
      };

      const updatePassB = () => {
        const pass = getSelectedPass(selectB);

        if (!pass?.image) return;

        imgB.src = pass.image;
        imgB.alt = pass.name;
      };

      /*
       * Both events are intentional:
       * - change handles normal mouse/keyboard selection.
       * - input keeps the image in sync on browsers that commit a native
       *   picker selection through the input event first.
       */
      selectA?.addEventListener('change', updatePassA);
      selectA?.addEventListener('input', updatePassA);
      selectB?.addEventListener('change', updatePassB);
      selectB?.addEventListener('input', updatePassB);
    }
  }

  customElements.define('dynamic-aov', DynamicAov);
</script>

<style>
  .aov-pass-select {
    max-width: min(42%, 220px);
  }

  .aov-pass-select-control {
    appearance: none;
    -webkit-appearance: none;
    width: 100%;
    min-width: 92px;
    padding: 0.5rem 2rem 0.5rem 0.75rem;
    border: 1px solid color-mix(in srgb, var(--color-cabilo-card) 85%, white 15%);
    border-radius: 0.375rem;
    background: color-mix(in srgb, var(--color-cabilo-obsidian) 88%, transparent);
    color: var(--color-text-white);
    backdrop-filter: blur(8px);
    font-size: 0.6875rem;
    font-weight: 700;
    letter-spacing: 0.12em;
    line-height: 1.2;
    text-transform: uppercase;
    cursor: pointer;
    outline: none;
  }

  .aov-pass-select-control:hover {
    border-color: var(--color-brand-amber);
  }

  .aov-pass-select-control:focus-visible {
    border-color: var(--color-brand-amber);
    box-shadow: 0 0 0 2px color-mix(in srgb, var(--color-brand-amber) 35%, transparent);
  }

  .aov-pass-select-control option {
    background: var(--color-cabilo-obsidian);
    color: var(--color-text-white);
  }

  @media (max-width: 640px) {
    .aov-pass-select {
      max-width: 46%;
    }

    .aov-pass-select-control {
      min-width: 0;
      padding-left: 0.625rem;
      padding-right: 1.75rem;
    }
  }
</style>