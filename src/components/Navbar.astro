---
/**
 * src/components/Navbar.astro
 */
---

<nav class="fixed top-0 left-0 w-full z-50 bg-cabilo-obsidian/90 backdrop-blur-md border-b border-cabilo-card">

  <div class="max-w-7xl mx-auto px-6 h-24 flex items-center justify-between relative">

    <!-- LOGO -->
    <a href="/" class="flex items-center group relative z-50">
      <img src="/logo-horizontal.svg" alt="CABILO Cinematic 3D" class="h-16 w-auto object-contain group-hover:opacity-80 transition-opacity duration-300" />
    </a>

    <!-- DESKTOP NAVIGATION -->
    <div class="hidden md:flex items-center gap-10 text-sm font-medium tracking-widest uppercase h-full">

      <a
        id="nav-work"
        href="/"
        class="nav-link transition-colors duration-300 text-text-silver hover:text-brand-gold"
      >
        Work
      </a>

      <div class="relative group h-full flex items-center">

        <button
          id="nav-learning"
          type="button"
          class="nav-link flex items-center gap-1 uppercase font-medium transition-colors duration-300 cursor-default text-text-silver group-hover:text-brand-gold"
        >
          LEARNING

          <svg
            class="w-4 h-4 transition-transform duration-300 group-hover:rotate-180"
            fill="none"
            stroke="currentColor"
            viewBox="0 0 24 24"
          >
            <path
              stroke-linecap="round"
              stroke-linejoin="round"
              stroke-width="2"
              d="M19 9l-7 7-7-7"
            ></path>
          </svg>
        </button>

        <div class="absolute top-[80px] left-0 w-48 bg-cabilo-obsidian/95 backdrop-blur-md border border-cabilo-card rounded-md shadow-2xl opacity-0 invisible group-hover:opacity-100 group-hover:visible transition-all duration-300 flex flex-col overflow-hidden z-50">

          <a
            id="nav-tutorials"
            href="/tutorials"
            class="nav-sub-link px-5 py-4 text-xs tracking-widest hover:bg-cabilo-card hover:text-brand-amber transition-colors border-b border-cabilo-card text-text-silver"
          >
            Tutorials
          </a>

          <a
            id="nav-breakdowns"
            href="/breakdowns"
            class="nav-sub-link px-5 py-4 text-xs tracking-widest hover:bg-cabilo-card hover:text-brand-amber transition-colors text-text-silver"
          >
            Breakdowns
          </a>

        </div>
      </div>

      <a
        id="nav-about"
        href="/about"
        class="nav-link transition-colors duration-300 text-text-silver hover:text-brand-gold"
      >
        About
      </a>

      <a
        id="nav-contact"
        href="/contact"
        class="nav-link transition-colors duration-300 text-text-silver hover:text-brand-gold"
      >
        Contact
      </a>

    </div>

    <!-- MOBILE HAMBURGER BUTTON -->
    <button
      id="mobile-menu-btn"
      class="md:hidden text-text-white focus:outline-none relative z-50"
      aria-label="Open mobile menu"
      aria-expanded="false"
      aria-controls="mobile-menu"
    >
      <svg
        class="w-8 h-8"
        fill="none"
        stroke="currentColor"
        viewBox="0 0 24 24"
      >
        <path
          stroke-linecap="round"
          stroke-linejoin="round"
          stroke-width="2"
          d="M4 6h16M4 12h16M4 18h16"
        ></path>
      </svg>
    </button>

  </div>
</nav>

<!-- MOBILE FADE-IN MENU -->
<!-- Kept outside the nav so backdrop-blur-md cannot affect fixed positioning on mobile browsers. -->
<div
  id="mobile-menu"
  aria-hidden="true"
  class="fixed inset-x-0 top-24 bottom-0 bg-cabilo-obsidian z-40 opacity-0 invisible pointer-events-none translate-y-2 transition-all duration-300 ease-in-out flex flex-col items-center justify-start pt-16 gap-8 md:hidden overflow-y-auto"
>
  <a
    id="mobile-nav-work"
    href="/"
    class="mobile-link text-2xl uppercase tracking-widest font-bold text-text-silver hover:text-brand-amber transition-colors"
  >
    Work
  </a>

  <a
    id="mobile-nav-tutorials"
    href="/tutorials"
    class="mobile-link text-2xl uppercase tracking-widest font-bold text-text-silver hover:text-brand-amber transition-colors"
  >
    Tutorials
  </a>

  <a
    id="mobile-nav-breakdowns"
    href="/breakdowns"
    class="mobile-link text-2xl uppercase tracking-widest font-bold text-text-silver hover:text-brand-amber transition-colors"
  >
    Breakdowns
  </a>

  <a
    id="mobile-nav-about"
    href="/about"
    class="mobile-link text-2xl uppercase tracking-widest font-bold text-text-silver hover:text-brand-amber transition-colors"
  >
    About
  </a>

  <a
    id="mobile-nav-contact"
    href="/contact"
    class="mobile-link text-2xl uppercase tracking-widest font-bold text-text-silver hover:text-brand-amber transition-colors"
  >
    Contact
  </a>
</div>

<script>
  const updateActiveNav = () => {
    const currentPath = window.location.pathname;

    const navWork = document.getElementById('nav-work');
    const navLearning = document.getElementById('nav-learning');
    const navTutorials = document.getElementById('nav-tutorials');
    const navBreakdowns = document.getElementById('nav-breakdowns');
    const navAbout = document.getElementById('nav-about');
    const navContact = document.getElementById('nav-contact');

    const mobileNavWork = document.getElementById('mobile-nav-work');
    const mobileNavTutorials = document.getElementById('mobile-nav-tutorials');
    const mobileNavBreakdowns = document.getElementById('mobile-nav-breakdowns');
    const mobileNavAbout = document.getElementById('mobile-nav-about');
    const mobileNavContact = document.getElementById('mobile-nav-contact');

    // Reset desktop main navigation states.
    navWork?.classList.remove('text-text-white');
    navWork?.classList.add('text-text-silver');

    navAbout?.classList.remove('text-text-white');
    navAbout?.classList.add('text-text-silver');

    navContact?.classList.remove('text-text-white');
    navContact?.classList.add('text-text-silver');

    // Reset desktop Learning navigation state.
    navLearning?.classList.remove('text-text-white');
    navLearning?.classList.add('text-text-silver');

    // Reset desktop Learning submenu states.
    navTutorials?.classList.remove('text-brand-gold');
    navTutorials?.classList.add('text-text-silver');

    navBreakdowns?.classList.remove('text-brand-gold');
    navBreakdowns?.classList.add('text-text-silver');

    // Reset mobile navigation states.
    mobileNavWork?.classList.remove('text-text-white');
    mobileNavWork?.classList.add('text-text-silver');

    mobileNavTutorials?.classList.remove('text-brand-amber');
    mobileNavTutorials?.classList.add('text-text-silver');

    mobileNavBreakdowns?.classList.remove('text-brand-amber');
    mobileNavBreakdowns?.classList.add('text-text-silver');

    mobileNavAbout?.classList.remove('text-text-white');
    mobileNavAbout?.classList.add('text-text-silver');

    mobileNavContact?.classList.remove('text-text-white');
    mobileNavContact?.classList.add('text-text-silver');

    // Set the active navigation item.
    if (currentPath === '/') {
      navWork?.classList.remove('text-text-silver');
      navWork?.classList.add('text-text-white');

      mobileNavWork?.classList.remove('text-text-silver');
      mobileNavWork?.classList.add('text-text-white');

    } else if (currentPath === '/about') {
      navAbout?.classList.remove('text-text-silver');
      navAbout?.classList.add('text-text-white');

      mobileNavAbout?.classList.remove('text-text-silver');
      mobileNavAbout?.classList.add('text-text-white');

    } else if (currentPath === '/contact') {
      navContact?.classList.remove('text-text-silver');
      navContact?.classList.add('text-text-white');

      mobileNavContact?.classList.remove('text-text-silver');
      mobileNavContact?.classList.add('text-text-white');

    } else if (currentPath.startsWith('/tutorials')) {
      navLearning?.classList.remove('text-text-silver');
      navLearning?.classList.add('text-text-white');

      navTutorials?.classList.remove('text-text-silver');
      navTutorials?.classList.add('text-brand-gold');

      mobileNavTutorials?.classList.remove('text-text-silver');
      mobileNavTutorials?.classList.add('text-brand-amber');

    } else if (currentPath.startsWith('/breakdowns')) {
      navLearning?.classList.remove('text-text-silver');
      navLearning?.classList.add('text-text-white');

      navBreakdowns?.classList.remove('text-text-silver');
      navBreakdowns?.classList.add('text-brand-gold');

      mobileNavBreakdowns?.classList.remove('text-text-silver');
      mobileNavBreakdowns?.classList.add('text-brand-amber');
    }
  };

  const setupMobileMenu = () => {
    const btn = document.getElementById('mobile-menu-btn');
    const menu = document.getElementById('mobile-menu');
    const links = document.querySelectorAll('.mobile-link');

    if (!btn || !menu) return;

    let isMenuOpen = false;

    const toggleMenu = () => {
      isMenuOpen = !isMenuOpen;

      if (isMenuOpen) {
        menu.classList.remove(
          'opacity-0',
          'invisible',
          'pointer-events-none',
          'translate-y-2'
        );

        menu.classList.add(
          'opacity-100',
          'visible',
          'pointer-events-auto',
          'translate-y-0'
        );

        btn.setAttribute('aria-expanded', 'true');
        btn.setAttribute('aria-label', 'Close mobile menu');
        menu.setAttribute('aria-hidden', 'false');

        document.body.style.overflow = 'hidden';
      } else {
        menu.classList.remove(
          'opacity-100',
          'visible',
          'pointer-events-auto',
          'translate-y-0'
        );

        menu.classList.add(
          'opacity-0',
          'invisible',
          'pointer-events-none',
          'translate-y-2'
        );

        btn.setAttribute('aria-expanded', 'false');
        btn.setAttribute('aria-label', 'Open mobile menu');
        menu.setAttribute('aria-hidden', 'true');

        document.body.style.overflow = '';
      }
    };

    // Keep the menu closed whenever the component is initialized.
    menu.classList.add(
      'opacity-0',
      'invisible',
      'pointer-events-none',
      'translate-y-2'
    );

    btn.addEventListener('click', toggleMenu);

    links.forEach(link => {
      link.addEventListener('click', () => {
        if (isMenuOpen) toggleMenu();
      });
    });
  };

  // Initialize the navigation state on the first page load.
  document.addEventListener('astro:page-load', updateActiveNav);

  // Re-run the navigation state after Astro client-side navigation.
  document.addEventListener('astro:after-swap', updateActiveNav);

  // Initialize the mobile menu.
  document.addEventListener('astro:page-load', setupMobileMenu);
</script>