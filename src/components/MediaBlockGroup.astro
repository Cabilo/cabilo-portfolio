---
/**
 * LEGACY: Media Blocks are retired from active page rendering.
 * Kept temporarily as rollback/reference code while Layout Blocks is the production system.
 */
/**
 * src/components/MediaBlockGroup.astro
 *
 * Renders a group of up to five media blocks in a configurable
 * responsive column layout. Groups can mix any media block type.
 */

import MediaBlocksRenderer from './MediaBlocksRenderer.astro';
import type { MediaBlock } from '../content.config';

export interface Props {
  blocks: MediaBlock[];
  columns: number;
}

const { blocks, columns } = Astro.props;

const columnClasses = {
  1: 'grid-cols-1',
  2: 'grid-cols-1 md:grid-cols-2',
  3: 'grid-cols-1 md:grid-cols-3',
  4: 'grid-cols-1 md:grid-cols-2 xl:grid-cols-4',
  5: 'grid-cols-1 md:grid-cols-2 lg:grid-cols-3 2xl:grid-cols-5',
} as const;

const gridClass = columnClasses[columns as keyof typeof columnClasses] ?? columnClasses[2];
---

<div class="mb-16">
  <div class:list={['grid gap-8 items-start', gridClass]}>
    <MediaBlocksRenderer blocks={blocks} compact />
  </div>
</div>
