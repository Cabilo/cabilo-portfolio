---
interface Props {
  frames: string[];
  fitToViewport?: boolean;
  statusPosition?: 'top' | 'right' | 'bottom' | 'left';
}

const {
  frames,
  fitToViewport = true,
  statusPosition = 'bottom',
} = Astro.props;

const frameDataString = JSON.stringify(frames);
---

<turntable-scrubber
  data-frames={frameDataString}
  data-fit-viewport={fitToViewport ? 'true' : 'false'}
  data-status-position={statusPosition}
  class:list={[
    'relative flex w-full flex-col items-center',
    !fitToViewport && 'h-full',
  ]}
>

  <div
    id="tt-container"
    class:list={[
      'relative mx-auto max-w-full bg-cabilo-obsidian overflow-hidden shadow-lg cursor-ew-resize flex items-center justify-center',
      !fitToViewport && 'w-full h-full',
    ]}
    style="touch-action: pan-y;"
  >

    <img
      id="tt-display"
      src={frames[0]}
      alt="3D Turntable"
      class={fitToViewport
        ? "block max-w-full max-h-[75vh] object-contain transition-transform duration-150 ease-out select-none"
        : "block w-full h-full object-contain transition-transform duration-150 ease-out select-none"
      }
      style="transform: scale(1); transform-origin: 50% 50%;"
      draggable="false"
    />

    <div
      id="tt-overlay"
      class="absolute inset-0 bg-black/10 flex flex-col items-center justify-center pointer-events-none transition-opacity duration-700 z-20"
    >
      <div
        class="flex flex-col items-center gap-2 bg-cabilo-dark/20 backdrop-blur-md px-6 py-4 rounded-xl border border-brand-amber/50 text-brand-amber shadow-[0_0_20px_rgba(230,115,0,0.3)]"
      >

        <svg
          class="w-6 h-6 animate-pulse mb-1"
          fill="none"
          stroke="currentColor"
          viewBox="0 0 24 24"
        >
          <path
            stroke-linecap="round"
            stroke-linejoin="round"
            stroke-width="2"
            d="M10 8l-4 4 4 4m4-8l4 4-4 4"
          ></path>
        </svg>

        <span class="text-xs uppercase tracking-widest font-bold text-text-white">
          Drag to Rotate
        </span>

        <span class="text-[10px] uppercase tracking-widest text-text-silver">
          Scroll to Zoom • Hover to Pan
        </span>

      </div>
    </div>

  </div>

  <!--
    The status readout belongs to the Turntable itself.
    Bottom is the default because it is the current portfolio presentation,
    but the component also supports top/left/right for future layouts.

    Side positions are absolutely positioned inside the Turntable rather
    than participating in the image's flex layout. This keeps the image
    centered and prevents the status from stealing width and pushing the
    image in the opposite direction.
  -->
  <div
    id="tt-status"
    class:list={[
      'z-30 flex items-center justify-center gap-5 text-[10px] font-mono tracking-widest text-text-silver',
      statusPosition !== 'bottom' && 'absolute pointer-events-none',
      statusPosition === 'bottom' && 'mt-0',
    ]}
  >
    <span>
      FRAME
      <span id="tt-counter" class="text-text-white font-bold">
        001
      </span>
      / {String(frames.length).padStart(3, '0')}
    </span>

    <span>
      ZOOM
      <span id="tt-zoom" class="text-text-white font-bold">
        1.0
      </span>x
    </span>
  </div>

</turntable-scrubber>

<script>
  class TurntableScrubber extends HTMLElement {
    connectedCallback() {
      if (this.dataset.initialized === 'true') return;

      this.dataset.initialized = 'true';

      const container =
        this.querySelector('#tt-container') as HTMLElement;

      const display =
        this.querySelector('#tt-display') as HTMLImageElement;

      const counter =
        this.querySelector('#tt-counter') as HTMLElement;

      const zoomCounter =
        this.querySelector('#tt-zoom') as HTMLElement;

      const overlay =
        this.querySelector('#tt-overlay') as HTMLElement;

      const framesData =
        this.getAttribute('data-frames');

      const fitViewport =
        this.dataset.fitViewport === 'true';

      if (!container || !display || !framesData) return;

      const frames =
        JSON.parse(framesData) as string[];

      const totalFrames =
        frames.length;

      if (totalFrames === 0) return;

      let currentFrameIndex = 0;

      let isDragging = false;

      let startX = 0;
      let startY = 0;
      let startFrame = 0;

      // Touch gestures can only control the turntable
      // when the gesture actually began inside it.
      let touchStartedInside = false;
      let touchGestureCancelled = false;

      let hasInteracted = false;

      let currentScale = 1;

      const minScale = 1;
      const maxScale = 5;

      const touchThreshold = 8;

      const imageCache =
        new Map<number, HTMLImageElement>();

      const loadingFrames =
        new Set<number>();

      const fitTurntableToViewport = () => {
        if (!fitViewport) {
          /*
           * Do not force a full-width frame when viewport fitting
           * is disabled. Let the frame follow the image's
           * intrinsic dimensions instead.
           */
          container.style.width = '';
          container.style.height = '';
          container.style.maxWidth = '100%';

          display.style.width = '';
          display.style.height = '';

          return;
        }

        if (
          !display.naturalWidth ||
          !display.naturalHeight
        ) {
          return;
        }

        const aspectRatio =
          display.naturalWidth /
          display.naturalHeight;

        const availableWidth =
          this.clientWidth;

        const availableHeight =
          window.innerHeight * 0.75;

        if (!availableWidth) return;

        const widthFromHeight =
          availableHeight * aspectRatio;

        const width =
          Math.min(
            availableWidth,
            widthFromHeight
          );

        const height =
          width / aspectRatio;

        /*
         * The frame follows the actual rendered image size.
         */
        container.style.width =
          `${width}px`;

        container.style.height =
          `${height}px`;

        container.style.maxWidth =
          '100%';

        display.style.width =
          `${width}px`;

        display.style.height =
          `${height}px`;
      };

      const loadFrame = (index: number) => {
        const normalizedIndex =
          ((index % totalFrames) + totalFrames) %
          totalFrames;

        if (
          imageCache.has(normalizedIndex) ||
          loadingFrames.has(normalizedIndex)
        ) {
          return;
        }

        loadingFrames.add(normalizedIndex);

        const img =
          new Image();

        img.onload = () => {
          imageCache.set(
            normalizedIndex,
            img
          );

          loadingFrames.delete(
            normalizedIndex
          );

          if (
            normalizedIndex ===
            currentFrameIndex
          ) {
            display.src =
              img.src;

            fitTurntableToViewport();
          }
        };

        img.onerror = () => {
          loadingFrames.delete(
            normalizedIndex
          );
        };

        img.src =
          frames[normalizedIndex];
      };

      let sensitivity =
        1;

      const updateSensitivity = () => {
        sensitivity =
          Math.max(
            container.clientWidth /
              totalFrames,
            1
          );
      };

      const updateFrame = (
        newIndex: number
      ) => {
        currentFrameIndex =
          ((newIndex % totalFrames) +
            totalFrames) %
          totalFrames;

        loadFrame(
          currentFrameIndex
        );

        const cachedImage =
          imageCache.get(
            currentFrameIndex
          );

        if (cachedImage) {
          display.src =
            cachedImage.src;

          fitTurntableToViewport();
        }

        counter.innerText =
          String(
            currentFrameIndex + 1
          ).padStart(3, '0');

        for (
          let offset = 1;
          offset <= 3;
          offset++
        ) {
          loadFrame(
            currentFrameIndex +
              offset
          );

          loadFrame(
            currentFrameIndex -
              offset
          );
        }
      };

      const updateTransformOrigin = (
        clientX: number,
        clientY: number
      ) => {
        const rect =
          container.getBoundingClientRect();

        if (
          rect.width === 0 ||
          rect.height === 0
        ) {
          return;
        }

        const x =
          Math.max(
            0,
            Math.min(
              100,
              ((clientX - rect.left) /
                rect.width) *
                100
            )
          );

        const y =
          Math.max(
            0,
            Math.min(
              100,
              ((clientY - rect.top) /
                rect.height) *
                100
            )
          );

        display.style.transformOrigin =
          `${x}% ${y}%`;
      };

      const startDrag = (
        e: MouseEvent | TouchEvent
      ) => {

        if ('touches' in e) {
          if (e.touches.length === 0) {
            return;
          }

          touchStartedInside = true;
          touchGestureCancelled = false;
          isDragging = false;

          startX =
            e.touches[0].clientX;

          startY =
            e.touches[0].clientY;

          startFrame =
            currentFrameIndex;

          if (
            !hasInteracted &&
            overlay
          ) {
            overlay.style.opacity = '0';
            hasInteracted = true;
          }

          return;
        }

        startX = e.clientX;
        startY = e.clientY;

        startFrame =
          currentFrameIndex;

        isDragging = true;

        if (
          !hasInteracted &&
          overlay
        ) {
          overlay.style.opacity = '0';
          hasInteracted = true;
        }

        this.style.cursor =
          'grabbing';
      };

      const doDrag = (
        e: MouseEvent | TouchEvent
      ) => {

        if ('touches' in e) {
          if (
            e.touches.length === 0
          ) {
            return;
          }

          // A gesture that started outside the turntable
          // can never activate it.
          if (
            !touchStartedInside ||
            touchGestureCancelled
          ) {
            return;
          }

          const currentX =
            e.touches[0].clientX;

          const currentY =
            e.touches[0].clientY;

          const diffX =
            currentX - startX;

          const diffY =
            currentY - startY;

          if (!isDragging) {

            if (
              Math.abs(diffX) <
                touchThreshold &&
              Math.abs(diffY) <
                touchThreshold
            ) {
              return;
            }

            // Vertical gesture:
            // permanently cancel turntable
            // interaction for this touch.
            if (
              Math.abs(diffY) >
              Math.abs(diffX)
            ) {
              touchGestureCancelled =
                true;

              isDragging = false;

              return;
            }

            isDragging = true;

            this.style.cursor =
              'grabbing';
          }

          e.preventDefault();

          const frameOffset =
            Math.round(
              diffX /
                sensitivity
            );

          updateFrame(
            startFrame +
              frameOffset
          );

          return;
        }

        if (!isDragging) {

          if (
            currentScale > 1
          ) {
            updateTransformOrigin(
              e.clientX,
              e.clientY
            );
          }

          return;
        }

        e.preventDefault();

        const diffX =
          e.clientX - startX;

        const frameOffset =
          Math.round(
            diffX /
              sensitivity
          );

        updateFrame(
          startFrame +
            frameOffset
        );
      };

      const stopDrag = () => {
        isDragging = false;

        touchStartedInside = false;
        touchGestureCancelled = false;

        this.style.cursor =
          currentScale > 1
            ? 'crosshair'
            : 'ew-resize';
      };

      container.addEventListener(
        'wheel',
        (e) => {
          e.preventDefault();

          if (
            !hasInteracted &&
            overlay
          ) {
            overlay.style.opacity = '0';
            hasInteracted = true;
          }

          updateTransformOrigin(
            e.clientX,
            e.clientY
          );

          currentScale +=
            e.deltaY * -0.002;

          currentScale =
            Math.min(
              Math.max(
                minScale,
                currentScale
              ),
              maxScale
            );

          display.style.transform =
            `scale(${currentScale})`;

          zoomCounter.innerText =
            currentScale.toFixed(1);

          this.style.cursor =
            currentScale > 1
              ? 'crosshair'
              : 'ew-resize';
        },
        { passive: false }
      );

      window.addEventListener(
        'resize',
        () => {
          updateSensitivity();
          fitTurntableToViewport();
        }
      );

      display.addEventListener(
        'load',
        () => {
          updateSensitivity();
          fitTurntableToViewport();
        }
      );

      container.addEventListener(
        'mousedown',
        startDrag
      );

      window.addEventListener(
        'mousemove',
        doDrag
      );

      window.addEventListener(
        'mouseup',
        stopDrag
      );

      container.addEventListener(
        'touchstart',
        startDrag,
        { passive: true }
      );

      window.addEventListener(
        'touchmove',
        doDrag,
        { passive: false }
      );

      window.addEventListener(
        'touchend',
        stopDrag
      );

      window.addEventListener(
        'touchcancel',
        stopDrag
      );

      updateSensitivity();

      fitTurntableToViewport();

      loadFrame(0);
    }
  }

  customElements.define(
    'turntable-scrubber',
    TurntableScrubber
  );
</script>

<style>
  turntable-scrubber[data-status-position="top"] #tt-status {
    top: 0;
    left: 50%;
    transform: translateX(-50%);
    white-space: nowrap;
  }

  turntable-scrubber[data-status-position="left"] #tt-status,
  turntable-scrubber[data-status-position="right"] #tt-status {
    top: 50%;
    flex-direction: column;
    gap: 0.35rem;
    white-space: nowrap;
  }

  turntable-scrubber[data-status-position="left"] #tt-status {
    left: 0;
    transform: translateY(-50%);
  }

  turntable-scrubber[data-status-position="right"] #tt-status {
    right: 0;
    transform: translateY(-50%);
  }

  /*
   * Side/top positions are intentionally overlay-style presentation modes:
   * the status stays inside the Turntable's own containing box and does not
   * participate in the image sizing calculation. This prevents a side
   * readout from pushing the image left/right or changing its dimensions.
   *
   * Layout Blocks already clip their Turntable wrapper to the authored
   * block footprint, so these alternate readout positions cannot spill into
   * neighboring blocks.
   */
  turntable-scrubber[data-status-position="top"] #tt-status,
  turntable-scrubber[data-status-position="left"] #tt-status,
  turntable-scrubber[data-status-position="right"] #tt-status {
    pointer-events: none;
  }

  @media (max-width: 767px) {
    /*
     * Keep the alternate readout modes compact on narrow screens.
     * The default bottom position remains normal and unchanged.
     */
    turntable-scrubber[data-status-position="left"] #tt-status,
    turntable-scrubber[data-status-position="right"] #tt-status {
      font-size: 9px;
      padding: 0.4rem 0.55rem;
    }
  }
</style>
