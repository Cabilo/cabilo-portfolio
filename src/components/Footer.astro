---
// src/components/Footer.astro
const currentYear = new Date().getFullYear();
---

<footer class="w-full bg-cabilo-obsidian border-t border-cabilo-card mt-20 pt-16 pb-8 px-6">
  <div class="max-w-7xl mx-auto flex flex-col md:flex-row justify-between items-center md:items-start gap-8">
    
    <!-- Left: Brand & Copyright -->
    <div class="flex flex-col items-center md:items-start gap-4">
      <img src="/logo-horizontal.png" alt="CABILO Cinematic 3D" class="h-6 w-auto opacity-70 grayscale hover:grayscale-0 hover:opacity-100 transition-all duration-500" />
      <p class="text-xs text-text-silver/60 uppercase tracking-widest">
        &copy; {currentYear} CABILO. All rights reserved.
      </p>
    </div>

    <!-- Right: Social / Professional Links -->
    <div class="flex gap-6">
      <a href="#" target="_blank" class="text-text-silver hover:text-brand-amber transition-colors duration-300 text-sm tracking-widest uppercase font-bold">ArtStation</a>
      <a href="#" target="_blank" class="text-text-silver hover:text-brand-amber transition-colors duration-300 text-sm tracking-widest uppercase font-bold">LinkedIn</a>
      <a href="#" target="_blank" class="text-text-silver hover:text-brand-amber transition-colors duration-300 text-sm tracking-widest uppercase font-bold">Vimeo</a>
      <a href="#" target="_blank" class="text-text-silver hover:text-brand-amber transition-colors duration-300 text-sm tracking-widest uppercase font-bold">Instagram</a>
    </div>

  </div>
</footer>