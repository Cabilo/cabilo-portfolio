---
// src/components/Footer.astro
const currentYear = new Date().getFullYear();
const locale = Astro.currentLocale === 'pt-br' ? 'pt-br' : 'en';
---

<footer class="w-full bg-cabilo-obsidian border-t border-cabilo-card mt-20 pt-4 pb-4 px-6">
  <div class="max-w-7xl mx-auto flex flex-col gap-4">
    <div class="flex flex-col md:flex-row justify-between items-center gap-8">
      
      <!-- Left: Brand -->
      <div class="flex flex-col items-center md:items-start gap-2">
        <img src="/logo-vertical.svg" alt="CABILO Cinematic 3D" class="h-24 w-auto opacity-70 grayscale hover:grayscale-0 hover:opacity-100 transition-all duration-500" />
      </div>

      <!-- Right: Social / Professional Links (SVG Icons) -->
    <div class="flex items-center gap-6">
      
      <!-- ArtStation (Placeholder: A) -->
      <a href="#" target="_blank" aria-label="ArtStation" class="text-text-silver hover:text-brand-amber transition-colors duration-300">
        <svg class="w-6 h-6" fill="currentColor" viewBox="0 0 24 24">
          <path d="M12 2L2 22h20L12 2zm0 4.5l5.5 11h-11L12 6.5z"/>
        </svg>
      </a>

      <!-- LinkedIn -->
      <a href="#" target="_blank" aria-label="LinkedIn" class="text-text-silver hover:text-brand-amber transition-colors duration-300">
        <svg class="w-6 h-6" fill="currentColor" viewBox="0 0 24 24">
          <path d="M19 0h-14c-2.761 0-5 2.239-5 5v14c0 2.761 2.239 5 5 5h14c2.762 0 5-2.239 5-5v-14c0-2.761-2.238-5-5-5zm-11 19h-3v-11h3v11zm-1.5-12.268c-.966 0-1.75-.79-1.75-1.764s.784-1.764 1.75-1.764 1.75.79 1.75 1.764-.783 1.764-1.75 1.764zm13.5 12.268h-3v-5.604c0-3.368-4-3.113-4 0v5.604h-3v-11h3v1.765c1.396-2.586 7-2.777 7 2.476v6.759z"/>
        </svg>
      </a>

      <!-- Vimeo -->
      <a href="#" target="_blank" aria-label="Vimeo" class="text-text-silver hover:text-brand-amber transition-colors duration-300">
        <svg class="w-6 h-6" fill="currentColor" viewBox="0 0 24 24">
          <path d="M22.396 7.164c-.093 2.026-1.507 4.8-4.245 8.32-2.836 3.635-5.253 5.453-7.253 5.453-1.215 0-2.262-1.353-3.14-4.062-1.03-4.05-1.85-6.195-2.457-6.435-.297-.107-.866-.547-1.706-1.32l.983-1.22c1.077-.96 2.05-1.666 2.92-2.12a4.42 4.42 0 0 1 2.122-.524c1.47.16 2.148 1.487 2.035 3.982.164 1.25.433 2.253.805 3.01.597 1.253 1.272 1.88 2.028 1.88.948 0 2.057-1.12 3.328-3.36.98-1.76 1.41-3.045 1.29-3.856-.164-1.16-1.11-1.707-2.837-1.642 1.47-1.783 3.3-2.613 5.488-2.49 2.06.12 3.033 1.517 2.92 4.186z"/>
        </svg>
      </a>

      <!-- Instagram -->
      <a href="#" target="_blank" aria-label="Instagram" class="text-text-silver hover:text-brand-amber transition-colors duration-300">
        <svg class="w-6 h-6" fill="currentColor" viewBox="0 0 24 24">
          <path d="M12 2.163c3.204 0 3.584.012 4.85.07 3.252.148 4.771 1.691 4.919 4.919.058 1.265.069 1.645.069 4.849 0 3.205-.012 3.584-.069 4.849-.149 3.225-1.664 4.771-4.919 4.919-1.266.058-1.644.07-4.85.07-3.204 0-3.584-.012-4.849-.07-3.26-.149-4.771-1.699-4.919-4.92-.058-1.265-.07-1.644-.07-4.849 0-3.204.013-3.583.07-4.849.149-3.227 1.664-4.771 4.919-4.919 1.266-.057 1.645-.069 4.849-.069zM12 0C8.741 0 8.333.014 7.053.072 2.695.272.273 2.69.073 7.052.014 8.333 0 8.741 0 12c0 3.259.014 3.668.072 4.948.2 4.358 2.618 6.78 6.98 6.98C8.333 23.986 8.741 24 12 24c3.259 0 3.668-.014 4.948-.072 4.354-.2 6.782-2.618 6.979-6.98.059-1.28.073-1.689.073-4.948 0-3.259-.014-3.667-.072-4.947-.196-4.354-2.617-6.78-6.979-6.98C15.668.014 15.259 0 12 0zm0 5.838a6.162 6.162 0 100 12.324 6.162 6.162 0 000-12.324zM12 16a4 4 0 110-8 4 4 0 010 8zm6.406-11.845a1.44 1.44 0 100 2.881 1.44 1.44 0 000-2.881z"/>
        </svg>
      </a>

    </div>
    </div>

    <p class="text-center text-xs text-text-silver/60 uppercase tracking-widest">
      &copy; {currentYear} CABILO. {locale === 'pt-br' ? 'Todos os direitos reservados.' : 'All rights reserved.'}
    </p>

  </div>
</footer>