---
import fs from 'node:fs';
import path from 'node:path';
import { parse } from 'marked';
import type { LayoutBlock } from '../content.config';
import { getVideoEmbed } from '../lib/video';
import TurntableScrubber from './TurntableScrubber.astro';
import DynamicAov from './DynamicAov.astro';

export interface Props {
  blocks: LayoutBlock[];
}

const { blocks } = Astro.props;

const normalizeFolder = (folder: string) =>
  folder
    .replace(/\\/g, '/')
    .replace(/^\/+/, '')
    .replace(/^public\//i, '');

const getTurntableFrames = (folder: string) => {
  const normalizedFolder = normalizeFolder(folder);
  const folderPath = path.join(process.cwd(), 'public', normalizedFolder);

  if (!fs.existsSync(folderPath)) return [];

  const files = fs.readdirSync(folderPath)
    .filter(file => /\.(jpg|jpeg|png|webp)$/i.test(file))
    .sort((a, b) => a.localeCompare(b, undefined, { numeric: true }));

  return files.map(file => `/${normalizedFolder}/${file}`);
};

const normalizedBlocks = blocks.map((block) => ({
  ...block,
  x: Math.max(0, Math.min(9, block.x)),
  y: Math.max(0, Math.min(99, block.y)),
  w: Math.max(1, Math.min(10 - block.x, block.w)),
  h: Math.max(1, Math.min(100 - block.y, block.h)),
}));

const maxBottom = Math.max(
  1,
  ...normalizedBlocks.map((block) => block.y + block.h),
);
---

{normalizedBlocks.length > 0 && (
  <section
    class="cabilo-layout-blocks"
    style={`--cabilo-layout-rows: ${Math.ceil(maxBottom / 2)};`}
    aria-label="Layout content"
  >
    {normalizedBlocks.map((block) => {
      const frameStyle = `
        --layout-x: ${block.x};
        --layout-y: ${block.y};
        --layout-w: ${block.w};
        --layout-h: ${block.h};
      `;

      const renderContent = () => {
        if (block.type === 'text') {
          const parsedHTML = parse(block.content) as string;

          return (
            <div class="cabilo-layout-text prose prose-invert prose-p:text-text-silver prose-headings:text-text-white prose-a:text-brand-amber max-w-none">
              {block.title && (
                <h3 class="text-xl text-text-white mb-6 uppercase tracking-wider">
                  {block.title}
                </h3>
              )}
              <div set:html={parsedHTML} />
            </div>
          );
        }

        if (block.type === 'image') {
          return (
            <div class="cabilo-layout-media">
              <img
                src={block.image}
                alt={block.title || 'Project media'}
                loading="lazy"
                draggable="false"
                data-layout-asset
              />
            </div>
          );
        }

        if (block.type === 'video') {
          const video = getVideoEmbed(block.videoUrl);

          if (!video) {
            return (
              <div class="cabilo-layout-placeholder">
                <p>Video URL not recognized.</p>
              </div>
            );
          }

          return (
            <div
              class="cabilo-layout-video"
              data-layout-video-ratio={video.type === 'youtube' || video.type === 'vimeo' ? '16 / 9' : ''}
            >
              {video.type === 'youtube' || video.type === 'vimeo' ? (
                <iframe
                  src={video.src}
                  title={block.title || 'Video'}
                  loading="lazy"
                  allow="autoplay; fullscreen; picture-in-picture"
                  allowfullscreen
                ></iframe>
              ) : (
                <video
                  src={video.src}
                  controls
                  preload="metadata"
                  playsinline
                  data-layout-asset
                ></video>
              )}
            </div>
          );
        }

        if (block.type === 'aov') {
          if (!block.aovPasses || block.aovPasses.length === 0) {
            return (
              <div class="cabilo-layout-placeholder">
                <p>AOV block has no passes yet.</p>
              </div>
            );
          }

          return (
            <div
              class="cabilo-layout-aov"
              data-layout-asset-src={block.aovPasses[0]?.image || ''}
            >
              <DynamicAov
                passes={block.aovPasses}
                fitToViewport={false}
              />
            </div>
          );
        }

        if (block.type === 'turntable') {
          const frames = getTurntableFrames(block.folder);

          if (frames.length === 0) {
            return (
              <div class="cabilo-layout-placeholder">
                <p>Turntable folder not found or contains no frames.</p>
              </div>
            );
          }

          return (
            <div
              class="cabilo-layout-turntable"
              data-layout-asset-src={frames[0] || ''}
            >
              <TurntableScrubber frames={frames} fitToViewport={false} />
            </div>
          );
        }

        return null;
      };

      return (
        <article
          class:list={[
            'cabilo-layout-frame',
            `cabilo-layout-frame-${block.type}`,
          ]}
          data-match-aspect={block.matchAspectRatio ? 'true' : 'false'}
          data-match-height-to-width={block.matchHeightToWidth ? 'true' : 'false'}
          data-asset-type={block.type}
          style={frameStyle}
        >
          {block.matchAspectRatio ? (
            <div class="cabilo-layout-asset-frame">
              {renderContent()}
            </div>
          ) : (
            renderContent()
          )}
        </article>
      );
    })}
  </section>
)}

<style>
  .cabilo-layout-blocks {
    --cabilo-layout-row-height: clamp(96px, 11vw, 180px);
    position: relative;
    width: 100%;
    height: calc(var(--cabilo-layout-rows) * var(--cabilo-layout-row-height));
    min-height: calc(var(--cabilo-layout-rows) * var(--cabilo-layout-row-height));
  }

  .cabilo-layout-frame {
    position: absolute;
    box-sizing: border-box;
    left: calc(var(--layout-x) * 10%);
    top: calc(var(--layout-y) / 2 * var(--cabilo-layout-row-height));
    width: calc(var(--layout-w) * 10%);
    height: calc(var(--layout-h) / 2 * var(--cabilo-layout-row-height));
    padding: clamp(8px, 1vw, 16px);
    overflow: visible;
  }

  /*
   * The Layout Block itself is always the authored grid slot.
   * Aspect matching only sizes the asset inside that slot.
   *
   * This intentionally follows the same container-first model used by
   * DynamicAov/TurntableScrubber when fitToViewport=false:
   * measure the available container, then calculate the media dimensions.
   */
  .cabilo-layout-asset-frame {
    position: relative;
    width: 100%;
    height: 100%;
    min-width: 0;
    min-height: 0;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .cabilo-layout-frame[data-match-aspect="true"] .cabilo-layout-asset-frame > * {
    flex: 0 0 auto;
    max-width: 100%;
    max-height: 100%;
  }

  .cabilo-layout-media,
  .cabilo-layout-video,
  .cabilo-layout-turntable {
    width: 100%;
    height: 100%;
    min-height: 0;
    overflow: hidden;
    border-radius: 0.375rem;
    background: var(--color-cabilo-card);
  }

  .cabilo-layout-media img {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: contain;
    object-position: center;
  }

  .cabilo-layout-video iframe,
  .cabilo-layout-video video {
    display: block;
    width: 100%;
    height: 100%;
    border: 0;
    object-fit: contain;
    background: #000;
  }

  .cabilo-layout-text {
    width: 100%;
    min-height: 100%;
    overflow: visible;
  }

  .cabilo-layout-aov {
    width: 100%;
    height: 100%;
    min-height: 0;
    overflow: visible;
  }

  .cabilo-layout-aov :global(.aov-container) {
    width: 100%;
    height: 100%;
  }

  .cabilo-layout-turntable {
    display: flex;
    align-items: stretch;
    justify-content: center;
    padding: 0;
    box-sizing: border-box;
  }

  .cabilo-layout-turntable :global(turntable-scrubber) {
    height: 100%;
    min-height: 0;
    min-width: 0;
  }

  .cabilo-layout-turntable :global(#tt-container) {
    flex: 1 1 auto;
    min-height: 0;
    height: auto !important;
  }

  .cabilo-layout-placeholder {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 100%;
    height: 100%;
    min-height: 0;
    padding: 1.5rem;
    box-sizing: border-box;
  }

  @media (max-width: 767px) {
    .cabilo-layout-blocks {
      display: flex;
      flex-direction: column;
      gap: 1rem;
      min-height: 0;
      height: auto;
    }

    .cabilo-layout-frame {
      position: relative;
      inset: auto;
      left: auto;
      top: auto;
      width: 100%;
      height: auto;
      min-height: 0;
      flex: 0 0 auto;
      padding: 0;
    }

    .cabilo-layout-frame[data-match-aspect="true"] .cabilo-layout-asset-frame {
      width: 100%;
      height: auto;
      min-height: 0;
      aspect-ratio: var(--asset-aspect-ratio, 1 / 1);
    }

    .cabilo-layout-frame[data-match-aspect="true"][data-match-height-to-width="false"] .cabilo-layout-asset-frame {
      width: auto;
      height: 100%;
      max-width: 100%;
      min-height: 0;
      aspect-ratio: var(--asset-aspect-ratio, 1 / 1);
    }

    .cabilo-layout-frame-image,
    .cabilo-layout-frame-video,
    .cabilo-layout-frame-turntable {
      height: clamp(240px, calc(var(--layout-h) * 18vw), 520px);
      min-height: 240px;
    }

    .cabilo-layout-frame-text {
      min-height: clamp(240px, calc(var(--layout-h) * 18vw), 520px);
      height: auto;
    }

    .cabilo-layout-frame-aov {
      min-height: 0;
      height: auto;
    }

    .cabilo-layout-frame-aov .cabilo-layout-aov {
      height: auto;
    }

    .cabilo-layout-frame-aov .cabilo-layout-aov :global(dynamic-aov) {
      height: auto !important;
      min-height: 0 !important;
    }

    .cabilo-layout-frame-aov .cabilo-layout-aov :global(dynamic-aov > div) {
      height: auto !important;
      min-height: 0 !important;
    }

    .cabilo-layout-frame-aov .cabilo-layout-aov :global(.aov-container) {
      flex: none;
      width: 100%;
      height: auto;
      aspect-ratio: 16 / 9;
    }

    .cabilo-layout-text {
      height: auto;
      min-height: inherit;
      overflow: visible;
    }

    .cabilo-layout-media,
    .cabilo-layout-video,
    .cabilo-layout-turntable {
      height: 100%;
      min-height: 0;
    }

    .cabilo-layout-turntable :global(turntable-scrubber) {
      height: 100%;
      min-height: 0;
    }

    .cabilo-layout-turntable :global(#tt-container) {
      min-height: 0;
      height: auto !important;
    }
  }
</style>

<script>
  const layoutSections = document.querySelectorAll('.cabilo-layout-blocks');

  const parseAspectRatio = (frame) => {
    const value = frame.style.getPropertyValue('--asset-aspect-ratio').trim();
    if (!value) return 0;

    const parts = value.split('/').map((part) => Number(part.trim()));
    if (parts.length !== 2 || !parts[0] || !parts[1]) return 0;

    const ratio = parts[0] / parts[1];
    return Number.isFinite(ratio) && ratio > 0 ? ratio : 0;
  };

  const sizeAspectAsset = (frame) => {
    if (frame.dataset.matchAspect !== 'true') return;

    const assetFrame = frame.querySelector('.cabilo-layout-asset-frame');
    const asset = assetFrame?.firstElementChild;

    if (!(assetFrame instanceof HTMLElement) || !(asset instanceof HTMLElement)) {
      return;
    }

    const ratio = parseAspectRatio(frame);

    if (!ratio) {
      asset.style.width = '';
      asset.style.height = '';
      return;
    }

    const availableWidth = assetFrame.clientWidth;
    const availableHeight = assetFrame.clientHeight;

    if (!availableWidth || !availableHeight) return;

    const heightFromWidth = availableWidth / ratio;
    const widthFromHeight = availableHeight * ratio;

    let width;
    let height;

    if (frame.dataset.matchHeightToWidth !== 'false') {
      /*
       * Width → Height:
       * start from the full available width, then clamp to the
       * available height if the requested aspect ratio is too tall.
       */
      width = availableWidth;
      height = heightFromWidth;

      if (height > availableHeight) {
        height = availableHeight;
        width = widthFromHeight;
      }
    } else {
      /*
       * Height → Width:
       * start from the full available height, then clamp to the
       * available width if the requested aspect ratio is too wide.
       */
      height = availableHeight;
      width = widthFromHeight;

      if (width > availableWidth) {
        width = availableWidth;
        height = heightFromWidth;
      }
    }

    asset.style.width = `${width}px`;
    asset.style.height = `${height}px`;
  };

  const loadLayoutAssetRatio = (frame) => {
    if (frame.dataset.matchAspect !== 'true') return;

    const applyRatio = (width, height) => {
      if (!width || !height) return;

      frame.style.setProperty(
        '--asset-aspect-ratio',
        `${width} / ${height}`,
      );

      requestAnimationFrame(() => {
        sizeAspectAsset(frame);
      });
    };

    const type = frame.dataset.assetType;

    if (type === 'image') {
      const image = frame.querySelector('[data-layout-asset]');

      if (image instanceof HTMLImageElement) {
        if (image.naturalWidth && image.naturalHeight) {
          applyRatio(image.naturalWidth, image.naturalHeight);
        } else {
          image.addEventListener('load', () => {
            applyRatio(image.naturalWidth, image.naturalHeight);
          }, { once: true });
        }
      }

      return;
    }

    if (type === 'video') {
      const video = frame.querySelector('[data-layout-asset]');

      if (video instanceof HTMLVideoElement) {
        if (video.videoWidth && video.videoHeight) {
          applyRatio(video.videoWidth, video.videoHeight);
        } else {
          video.addEventListener('loadedmetadata', () => {
            applyRatio(video.videoWidth, video.videoHeight);
          }, { once: true });
        }
      } else {
        const ratio = frame
          .querySelector('.cabilo-layout-video')
          ?.getAttribute('data-layout-video-ratio');

        if (ratio) {
          frame.style.setProperty('--asset-aspect-ratio', ratio);
          requestAnimationFrame(() => {
            sizeAspectAsset(frame);
          });
        }
      }

      return;
    }

    if (type === 'aov' || type === 'turntable') {
      const source = frame
        .querySelector('[data-layout-asset-src]')
        ?.getAttribute('data-layout-asset-src');

      if (!source) return;

      const image = new Image();

      image.onload = () => {
        applyRatio(image.naturalWidth, image.naturalHeight);
      };

      image.src = source;
    }
  };

  layoutSections.forEach((section) => {
    const aspectFrames = section.querySelectorAll(
      '.cabilo-layout-frame[data-match-aspect="true"]',
    );

    aspectFrames.forEach((frame) => {
      loadLayoutAssetRatio(frame);
    });

    const updateAspectSizes = () => {
      if (window.matchMedia('(max-width: 767px)').matches) {
        aspectFrames.forEach((frame) => {
          sizeAspectAsset(frame);
        });
      } else {
        aspectFrames.forEach((frame) => {
          sizeAspectAsset(frame);
        });
      }
    };

    const updateHeight = () => {
      if (window.matchMedia('(max-width: 767px)').matches) {
        section.style.height = '';
        updateAspectSizes();
        return;
      }

      const baseHeight = section.scrollHeight;
      let requiredHeight = baseHeight;

      section.querySelectorAll('.cabilo-layout-frame').forEach((frame) => {
        requiredHeight = Math.max(
          requiredHeight,
          frame.offsetTop + frame.scrollHeight,
        );
      });

      section.style.height = requiredHeight + 'px';
      updateAspectSizes();
    };

    updateHeight();

    const observer = new ResizeObserver(() => {
      requestAnimationFrame(updateHeight);
    });

    section.querySelectorAll('.cabilo-layout-frame').forEach((frame) => {
      observer.observe(frame);
    });

    window.addEventListener('resize', updateHeight);
  });
</script>
