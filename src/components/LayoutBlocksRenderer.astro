---
import fs from 'node:fs';
import path from 'node:path';
import { parse } from 'marked';
import type { LayoutBlock } from '../content.config';
import { getVideoEmbed } from '../lib/video';
import TurntableScrubber from './TurntableScrubber.astro';
import DynamicAov from './DynamicAov.astro';

export interface Props {
  blocks: LayoutBlock[];
}

const { blocks } = Astro.props;

const normalizeFolder = (folder: string) =>
  folder
    .replace(/\\/g, '/')
    .replace(/^\/+/, '')
    .replace(/^public\//i, '');

const getTurntableFrames = (folder: string) => {
  const normalizedFolder = normalizeFolder(folder);
  const folderPath = path.join(process.cwd(), 'public', normalizedFolder);

  if (!fs.existsSync(folderPath)) return [];

  const files = fs.readdirSync(folderPath)
    .filter(file => /\.(jpg|jpeg|png|webp)$/i.test(file))
    .sort((a, b) => a.localeCompare(b, undefined, { numeric: true }));

  return files.map(file => `/${normalizedFolder}/${file}`);
};

const normalizedBlocks = blocks.map((block) => ({
  ...block,
  x: Math.max(0, Math.min(9, block.x)),
  y: Math.max(0, Math.min(99, block.y)),
  w: Math.max(1, Math.min(10 - block.x, block.w)),
  h: Math.max(1, Math.min(100 - block.y, block.h)),
}));

const maxBottom = Math.max(
  1,
  ...normalizedBlocks.map((block) => block.y + block.h),
);
---

{normalizedBlocks.length > 0 && (
  <section
    class="cabilo-layout-blocks"
    style={`--cabilo-layout-rows: ${Math.ceil(maxBottom / 2)};`}
    aria-label="Layout content"
  >
    {normalizedBlocks.map((block) => {
      const frameStyle = `
        --layout-x: ${block.x};
        --layout-y: ${block.y};
        --layout-w: ${block.w};
        --layout-h: ${block.h};
      `;

      const renderContent = () => {
        if (block.type === 'text') {
          const parsedHTML = parse(block.content) as string;

          return (
            <div class="cabilo-layout-text prose prose-invert prose-p:text-text-silver prose-headings:text-text-white prose-a:text-brand-amber max-w-none">
              {block.title && (
                <h3 class="text-xl text-text-white mb-6 uppercase tracking-wider">
                  {block.title}
                </h3>
              )}
              <div set:html={parsedHTML} />
            </div>
          );
        }

        if (block.type === 'image') {
          return (
            <div class="cabilo-layout-media">
              <img
                src={block.image}
                alt={block.title || 'Project media'}
                loading="lazy"
                draggable="false"
                data-layout-asset
              />
            </div>
          );
        }

        if (block.type === 'video') {
          const video = getVideoEmbed(block.videoUrl);

          if (!video) {
            return (
              <div class="cabilo-layout-placeholder">
                <p>Video URL not recognized.</p>
              </div>
            );
          }

          return (
            <div
              class="cabilo-layout-video"
              data-layout-video-ratio={video.type === 'youtube' || video.type === 'vimeo' ? '16 / 9' : ''}
            >
              {video.type === 'youtube' || video.type === 'vimeo' ? (
                <iframe
                  src={video.src}
                  title={block.title || 'Video'}
                  loading="lazy"
                  allow="autoplay; fullscreen; picture-in-picture"
                  allowfullscreen
                ></iframe>
              ) : (
                <video
                  src={video.src}
                  controls
                  preload="metadata"
                  playsinline
                  data-layout-asset
                ></video>
              )}
            </div>
          );
        }

        if (block.type === 'aov') {
          if (!block.aovPasses || block.aovPasses.length === 0) {
            return (
              <div class="cabilo-layout-placeholder">
                <p>AOV block has no passes yet.</p>
              </div>
            );
          }

          return (
            <div
              class="cabilo-layout-aov"
              data-layout-asset-src={block.aovPasses[0]?.image || ''}
            >
              <DynamicAov
                passes={block.aovPasses}
                fitToViewport={false}
              />
            </div>
          );
        }

        if (block.type === 'turntable') {
          const frames = getTurntableFrames(block.folder);

          if (frames.length === 0) {
            return (
              <div class="cabilo-layout-placeholder">
                <p>Turntable folder not found or contains no frames.</p>
              </div>
            );
          }

          return (
            <div
              class="cabilo-layout-turntable"
              data-layout-asset-src={frames[0] || ''}
            >
              <TurntableScrubber frames={frames} fitToViewport={false} />
            </div>
          );
        }

        return null;
      };

      return (
        <article
          class:list={[
            'cabilo-layout-frame',
            `cabilo-layout-frame-${block.type}`,
          ]}
          data-fit-mode={block.fitMode}
          data-asset-type={block.type}
          style={frameStyle}
        >
          {block.fitMode !== 'none' ? (
            <div class="cabilo-layout-asset-frame">
              {renderContent()}
            </div>
          ) : (
            renderContent()
          )}
        </article>
      );
    })}
  </section>
)}

<style>
  .cabilo-layout-blocks {
    --cabilo-layout-row-height: clamp(96px, 11vw, 180px);
    position: relative;
    width: 100%;
    height: calc(var(--cabilo-layout-rows) * var(--cabilo-layout-row-height));
    min-height: calc(var(--cabilo-layout-rows) * var(--cabilo-layout-row-height));
  }

  .cabilo-layout-frame {
    position: absolute;
    box-sizing: border-box;
    left: calc(var(--layout-x) * 10%);
    top: calc(var(--layout-y) / 2 * var(--cabilo-layout-row-height));
    width: calc(var(--layout-w) * 10%);
    height: calc(var(--layout-h) / 2 * var(--cabilo-layout-row-height));
    padding: clamp(8px, 1vw, 16px);
    overflow: visible;
  }

  /*
   * The Layout Block is the authored slot.
   * Fit modes control the media frame inside that slot:
   * - none: use the full authored slot.
   * - width-to-height: width is authoritative; height follows the asset ratio.
   * - height-to-width: height is authoritative; width follows the asset ratio.
   *
   * CSS aspect-ratio is used here instead of manually calculating both
   * dimensions in JavaScript. This makes the two directions genuinely
   * different: only one side is fixed in each fit mode.
   */
  .cabilo-layout-asset-frame {
    position: relative;
    min-width: 0;
    min-height: 0;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .cabilo-layout-frame[data-fit-mode="width-to-height"] .cabilo-layout-asset-frame {
    width: 100%;
    height: auto;
    aspect-ratio: var(--asset-aspect-ratio);
  }

  .cabilo-layout-frame[data-fit-mode="height-to-width"] .cabilo-layout-asset-frame {
    width: auto;
    height: 100%;
    aspect-ratio: var(--asset-aspect-ratio);
  }

  .cabilo-layout-frame[data-fit-mode="none"] .cabilo-layout-asset-frame {
    width: 100%;
    height: 100%;
  }

  .cabilo-layout-frame[data-fit-mode="width-to-height"] .cabilo-layout-asset-frame > *,
  .cabilo-layout-frame[data-fit-mode="height-to-width"] .cabilo-layout-asset-frame > * {
    flex: 0 0 auto;
    width: 100%;
    height: 100%;
  }

  .cabilo-layout-media,
  .cabilo-layout-video,
  .cabilo-layout-turntable {
    width: 100%;
    height: 100%;
    min-height: 0;
    overflow: hidden;
    border-radius: 0.375rem;
    background: var(--color-cabilo-card);
  }

  .cabilo-layout-media img {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: contain;
    object-position: center;
  }

  .cabilo-layout-video iframe,
  .cabilo-layout-video video {
    display: block;
    width: 100%;
    height: 100%;
    border: 0;
    object-fit: contain;
    background: #000;
  }

  .cabilo-layout-text {
    width: 100%;
    min-height: 100%;
    overflow: visible;
  }

  .cabilo-layout-aov {
    width: 100%;
    height: 100%;
    min-height: 0;
    overflow: visible;
  }

  .cabilo-layout-aov :global(.aov-container) {
    width: 100%;
    height: 100%;
  }

  .cabilo-layout-turntable {
    display: flex;
    align-items: stretch;
    justify-content: center;
    padding: 0;
    box-sizing: border-box;
  }

  .cabilo-layout-turntable :global(turntable-scrubber) {
    height: 100%;
    min-height: 0;
    min-width: 0;
  }

  .cabilo-layout-turntable :global(#tt-container) {
    flex: 1 1 auto;
    min-height: 0;
    height: auto !important;
  }

  .cabilo-layout-placeholder {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 100%;
    height: 100%;
    min-height: 0;
    padding: 1.5rem;
    box-sizing: border-box;
  }

  @media (max-width: 767px) {
    .cabilo-layout-blocks {
      display: flex;
      flex-direction: column;
      gap: 1rem;
      min-height: 0;
      height: auto;
    }

    .cabilo-layout-frame {
      position: relative;
      inset: auto;
      left: auto;
      top: auto;
      width: 100%;
      height: auto;
      min-height: 0;
      flex: 0 0 auto;
      padding: 0;
    }

    /*
     * Keep the asset frame as the full mobile block container too.
     * The client-side aspect sizing code controls only the media child.
     */
    .cabilo-layout-frame[data-match-aspect="true"] .cabilo-layout-asset-frame {
      width: 100%;
      height: 100%;
      min-height: 0;
    }

    .cabilo-layout-frame-image,
    .cabilo-layout-frame-video,
    .cabilo-layout-frame-turntable {
      height: clamp(240px, calc(var(--layout-h) * 18vw), 520px);
      min-height: 240px;
    }

    .cabilo-layout-frame-text {
      min-height: clamp(240px, calc(var(--layout-h) * 18vw), 520px);
      height: auto;
    }

    .cabilo-layout-frame-aov {
      min-height: 0;
      height: auto;
    }

    .cabilo-layout-frame-aov .cabilo-layout-aov {
      height: auto;
    }

    .cabilo-layout-frame-aov .cabilo-layout-aov :global(dynamic-aov) {
      height: auto !important;
      min-height: 0 !important;
    }

    .cabilo-layout-frame-aov .cabilo-layout-aov :global(dynamic-aov > div) {
      height: auto !important;
      min-height: 0 !important;
    }

    .cabilo-layout-frame-aov .cabilo-layout-aov :global(.aov-container) {
      flex: none;
      width: 100%;
      height: auto;
      aspect-ratio: 16 / 9;
    }

    .cabilo-layout-text {
      height: auto;
      min-height: inherit;
      overflow: visible;
    }

    .cabilo-layout-media,
    .cabilo-layout-video,
    .cabilo-layout-turntable {
      height: 100%;
      min-height: 0;
    }

    .cabilo-layout-turntable :global(turntable-scrubber) {
      height: 100%;
      min-height: 0;
    }

    .cabilo-layout-turntable :global(#tt-container) {
      min-height: 0;
      height: auto !important;
    }
  }
</style>

<script>
  const layoutSections = document.querySelectorAll('.cabilo-layout-blocks');

  const setAssetRatio = (frame, width, height) => {
    if (!width || !height) return;

    frame.style.setProperty(
      '--asset-aspect-ratio',
      `${width} / ${height}`,
    );
  };

  const loadLayoutAssetRatio = (frame) => {
    const fitMode = frame.dataset.fitMode;

    if (fitMode === 'none') return;

    const applyRatio = (width, height) => {
      if (!width || !height) return;

      setAssetRatio(frame, width, height);
      requestAnimationFrame(() => {
        frame.dispatchEvent(new Event('layout-aspect-ready'));
      });
    };

    const type = frame.dataset.assetType;

    if (type === 'image') {
      const image = frame.querySelector('[data-layout-asset]');

      if (image instanceof HTMLImageElement) {
        if (image.naturalWidth && image.naturalHeight) {
          applyRatio(image.naturalWidth, image.naturalHeight);
        } else {
          image.addEventListener('load', () => {
            applyRatio(image.naturalWidth, image.naturalHeight);
          }, { once: true });
        }
      }

      return;
    }

    if (type === 'video') {
      const video = frame.querySelector('[data-layout-asset]');

      if (video instanceof HTMLVideoElement) {
        if (video.videoWidth && video.videoHeight) {
          applyRatio(video.videoWidth, video.videoHeight);
        } else {
          video.addEventListener('loadedmetadata', () => {
            applyRatio(video.videoWidth, video.videoHeight);
          }, { once: true });
        }
      } else {
        const ratio = frame
          .querySelector('.cabilo-layout-video')
          ?.getAttribute('data-layout-video-ratio');

        if (ratio) {
          const parts = ratio.split('/').map((part) => Number(part.trim()));

          if (parts.length === 2 && parts[0] > 0 && parts[1] > 0) {
            applyRatio(parts[0], parts[1]);
          }
        }
      }

      return;
    }

    if (type === 'aov' || type === 'turntable') {
      const source = frame
        .querySelector('[data-layout-asset-src]')
        ?.getAttribute('data-layout-asset-src');

      if (!source) return;

      const image = new Image();

      image.onload = () => {
        applyRatio(image.naturalWidth, image.naturalHeight);
      };

      image.src = source;
    }
  };

  layoutSections.forEach((section) => {
    const aspectFrames = section.querySelectorAll(
      '.cabilo-layout-frame[data-fit-mode]:not([data-fit-mode="none"])',
    );

    aspectFrames.forEach((frame) => {
      loadLayoutAssetRatio(frame);
    });

    const updateHeight = () => {
      if (window.matchMedia('(max-width: 767px)').matches) {
        section.style.height = '';
        return;
      }

      const baseHeight = section.scrollHeight;
      let requiredHeight = baseHeight;

      section.querySelectorAll('.cabilo-layout-frame').forEach((frame) => {
        requiredHeight = Math.max(
          requiredHeight,
          frame.offsetTop + frame.scrollHeight,
        );
      });

      section.style.height = requiredHeight + 'px';
    };

    updateHeight();

    const observer = new ResizeObserver(() => {
      requestAnimationFrame(updateHeight);
    });

    section.querySelectorAll('.cabilo-layout-frame, .cabilo-layout-asset-frame').forEach((element) => {
      observer.observe(element);
    });

    window.addEventListener('resize', updateHeight);
  });
</script>