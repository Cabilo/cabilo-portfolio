---
import fs from 'node:fs';
import path from 'node:path';
import { parse } from 'marked';
import type { LayoutBlock } from '../content.config';
import { getVideoEmbed } from '../lib/video';
import TurntableScrubber from './TurntableScrubber.astro';
import DynamicAov from './DynamicAov.astro';

export interface Props {
  blocks: LayoutBlock[];
}

const { blocks } = Astro.props;

const normalizeFolder = (folder: string) =>
  folder
    .replace(/\\/g, '/')
    .replace(/^\/+/, '')
    .replace(/^public\//i, '');

const getTurntableFrames = (folder: string) => {
  const normalizedFolder = normalizeFolder(folder);
  const folderPath = path.join(process.cwd(), 'public', normalizedFolder);

  if (!fs.existsSync(folderPath)) return [];

  const files = fs.readdirSync(folderPath)
    .filter(file => /\.(jpg|jpeg|png|webp)$/i.test(file))
    .sort((a, b) => a.localeCompare(b, undefined, { numeric: true }));

  return files.map(file => `/${normalizedFolder}/${file}`);
};

const normalizedBlocks = blocks.map((block) => ({
  ...block,
  x: Math.max(0, Math.min(9, block.x)),
  y: Math.max(0, Math.min(99, block.y)),
  w: Math.max(1, Math.min(10 - block.x, block.w)),
  h: Math.max(1, Math.min(100 - block.y, block.h)),
}));

const maxBottom = Math.max(
  1,
  ...normalizedBlocks.map((block) => block.y + block.h),
);
---

{normalizedBlocks.length > 0 && (
  <section
    class="cabilo-layout-blocks"
    style={`--cabilo-layout-rows: ${Math.ceil(maxBottom / 2)};`}
    aria-label="Layout content"
  >
    {normalizedBlocks.map((block) => {
      const frameStyle = `
        --layout-x: ${block.x};
        --layout-y: ${block.y};
        --layout-w: ${block.w};
        --layout-h: ${block.h};
      `;

      const renderContent = () => {
        if (block.type === 'text') {
          const parsedHTML = parse(block.content) as string;

          return (
            <div class="cabilo-layout-text prose prose-invert prose-p:text-text-silver prose-headings:text-text-white prose-a:text-brand-amber max-w-none">
              {block.title && (
                <h3 class="text-xl text-text-white mb-6 uppercase tracking-wider">
                  {block.title}
                </h3>
              )}
              <div set:html={parsedHTML} />
            </div>
          );
        }

        if (block.type === 'image') {
          return (
            <div class="cabilo-layout-media">
              <img
                src={block.image}
                alt={block.title || 'Project media'}
                loading="lazy"
                draggable="false"
                data-layout-asset
              />
            </div>
          );
        }

        if (block.type === 'video') {
          const video = getVideoEmbed(block.videoUrl);

          if (!video) {
            return (
              <div class="cabilo-layout-placeholder">
                <p>Video URL not recognized.</p>
              </div>
            );
          }

          return (
            <div
              class="cabilo-layout-video"
              data-layout-video-ratio={video.type === 'youtube' || video.type === 'vimeo' ? '16 / 9' : ''}
            >
              {video.type === 'youtube' || video.type === 'vimeo' ? (
                <iframe
                  src={video.src}
                  title={block.title || 'Video'}
                  loading="lazy"
                  allow="autoplay; fullscreen; picture-in-picture"
                  allowfullscreen
                ></iframe>
              ) : (
                <video
                  src={video.src}
                  controls
                  preload="metadata"
                  playsinline
                  data-layout-asset
                ></video>
              )}
            </div>
          );
        }

        if (block.type === 'aov') {
          if (!block.aovPasses || block.aovPasses.length === 0) {
            return (
              <div class="cabilo-layout-placeholder">
                <p>AOV block has no passes yet.</p>
              </div>
            );
          }

          return (
            <div
              class="cabilo-layout-aov"
              data-layout-asset-src={block.aovPasses[0]?.image || ''}
            >
              <DynamicAov
                passes={block.aovPasses}
                fitToViewport={false}
                fitToLayoutAspect
              />
            </div>
          );
        }

        if (block.type === 'turntable') {
          const frames = getTurntableFrames(block.folder);

          if (frames.length === 0) {
            return (
              <div class="cabilo-layout-placeholder">
                <p>Turntable folder not found or contains no frames.</p>
              </div>
            );
          }

          return (
            <div
              class="cabilo-layout-turntable"
              data-layout-asset-src={frames[0] || ''}
            >
              <TurntableScrubber frames={frames} fitToViewport={false} />
            </div>
          );
        }

        return null;
      };

      return (
        <article
          class:list={[
            'cabilo-layout-frame',
            `cabilo-layout-frame-${block.type}`,
          ]}
          data-fit-mode={block.fitMode}
          data-asset-type={block.type}
          style={frameStyle}
        >
          {block.fitMode !== 'none' ? (
            <div class="cabilo-layout-asset-frame">
              {renderContent()}
            </div>
          ) : (
            renderContent()
          )}
        </article>
      );
    })}
  </section>
)}

<style>
  .cabilo-layout-blocks {
    --cabilo-layout-row-height: clamp(96px, 11vw, 180px);
    position: relative;
    width: 100%;
    height: calc(var(--cabilo-layout-rows) * var(--cabilo-layout-row-height));
    min-height: calc(var(--cabilo-layout-rows) * var(--cabilo-layout-row-height));
  }

  .cabilo-layout-frame {
    position: absolute;
    box-sizing: border-box;
    left: calc(var(--layout-x) * 10%);
    top: calc(var(--layout-y) / 2 * var(--cabilo-layout-row-height));
    width: calc(var(--layout-w) * 10%);
    height: calc(var(--layout-h) / 2 * var(--cabilo-layout-row-height));
    padding: clamp(8px, 1vw, 16px);
    overflow: visible;
  }

  /*
   * The Layout Block is the authored slot.
   * Fit modes control the media frame inside that slot:
   * - none: use the full authored slot.
   * - width-to-height: width is authoritative; height follows the asset ratio.
   * - height-to-width: height is authoritative; width follows the asset ratio.
   *
   * CSS aspect-ratio is used here instead of manually calculating both
   * dimensions in JavaScript. This makes the two directions genuinely
   * different: only one side is fixed in each fit mode.
   */
  .cabilo-layout-asset-frame {
    position: relative;
    min-width: 0;
    min-height: 0;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .cabilo-layout-frame[data-fit-mode="width-to-height"] .cabilo-layout-asset-frame {
    width: 100%;
    height: auto;
    aspect-ratio: var(--asset-aspect-ratio);
  }

  .cabilo-layout-frame[data-fit-mode="height-to-width"] {
    display: flex;
    align-items: flex-start;
    justify-content: center;
  }

  .cabilo-layout-frame[data-fit-mode="height-to-width"] .cabilo-layout-asset-frame {
    flex: 0 0 auto;
    width: auto;
    height: 100%;
    aspect-ratio: var(--asset-aspect-ratio);
  }

  .cabilo-layout-frame[data-fit-mode="none"] .cabilo-layout-asset-frame {
    width: 100%;
    height: 100%;
  }

  .cabilo-layout-frame[data-fit-mode="width-to-height"] .cabilo-layout-asset-frame > *,
  .cabilo-layout-frame[data-fit-mode="height-to-width"] .cabilo-layout-asset-frame > * {
    flex: 0 0 auto;
    width: 100%;
    height: 100%;
  }

  /*
   * AOV has its own controls below the comparison viewport.
   * In Layout Blocks, the viewport itself follows the asset ratio;
   * the controls remain in normal flow so they contribute to the
   * block's measured height instead of spilling outside it.
   *
   * Height → Width is special for AOV because the block is a composite:
   * the comparison viewport has an authored height, while the selector
   * panel below it can grow when pass buttons wrap. Let the AOV itself
   * grow naturally so the Layout Blocks resolver can measure that full
   * vertical footprint without changing the authored viewport height.
   */
  .cabilo-layout-frame[data-fit-mode="width-to-height"] .cabilo-layout-aov {
    height: auto;
  }

  .cabilo-layout-frame[data-fit-mode="width-to-height"] .cabilo-layout-aov :global(dynamic-aov) {
    height: auto;
    min-height: 0;
  }

  .cabilo-layout-frame-aov[data-fit-mode="height-to-width"] .cabilo-layout-aov {
    height: auto;
    min-height: 0;
  }

  .cabilo-layout-frame-aov[data-fit-mode="height-to-width"] .cabilo-layout-aov :global(dynamic-aov) {
    height: auto;
    min-height: 0;
  }

  .cabilo-layout-frame-aov[data-fit-mode="height-to-width"] .cabilo-layout-aov :global(dynamic-aov > div) {
    height: auto;
    min-height: 0;
  }

  .cabilo-layout-media,
  .cabilo-layout-video {
    width: 100%;
    height: 100%;
    min-height: 0;
    overflow: hidden;
    border-radius: 0.375rem;
    background: var(--color-cabilo-card);
  }

  .cabilo-layout-turntable {
    width: 100%;
    height: 100%;
    min-height: 0;
    overflow: visible;
    border-radius: 0.375rem;
    background: var(--color-cabilo-card);
  }

  .cabilo-layout-media img {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: contain;
    object-position: center;
  }

  .cabilo-layout-video iframe,
  .cabilo-layout-video video {
    display: block;
    width: 100%;
    height: 100%;
    border: 0;
    object-fit: contain;
    background: #000;
  }

  .cabilo-layout-text {
    width: 100%;
    min-height: 100%;
    overflow: visible;
  }

  .cabilo-layout-aov {
    width: 100%;
    height: 100%;
    min-height: 0;
    overflow: visible;
  }

  .cabilo-layout-aov :global(.aov-container) {
    width: 100%;
    height: 100%;
  }

  .cabilo-layout-turntable {
    display: flex;
    align-items: stretch;
    justify-content: center;
    padding: 0;
    box-sizing: border-box;
  }

  .cabilo-layout-turntable :global(turntable-scrubber) {
    height: 100%;
    min-height: 0;
    min-width: 0;
  }

  .cabilo-layout-turntable :global(#tt-container) {
    flex: 1 1 auto;
    min-height: 0;
    height: auto !important;
  }

  .cabilo-layout-placeholder {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 100%;
    height: 100%;
    min-height: 0;
    padding: 1.5rem;
    box-sizing: border-box;
  }

  @media (max-width: 767px) {
    .cabilo-layout-blocks {
      display: flex;
      flex-direction: column;
      gap: 1rem;
      min-height: 0;
      height: auto;
    }

    .cabilo-layout-frame {
      position: relative;
      inset: auto;
      left: auto;
      top: auto;
      width: 100%;
      height: auto;
      min-height: 0;
      flex: 0 0 auto;
      padding: 0;
    }

    .cabilo-layout-frame-image,
    .cabilo-layout-frame-video,
    .cabilo-layout-frame-turntable {
      height: clamp(240px, calc(var(--layout-h) * 18vw), 520px);
      min-height: 240px;
    }

    /*
     * On mobile, Width → Height should be allowed to derive the block's
     * height from its full available width. Height → Width keeps the
     * mobile block height as the authoritative side.
     */
    .cabilo-layout-frame-image[data-fit-mode="width-to-height"],
    .cabilo-layout-frame-video[data-fit-mode="width-to-height"],
    .cabilo-layout-frame-turntable[data-fit-mode="width-to-height"],
    .cabilo-layout-frame-aov[data-fit-mode="width-to-height"] {
      height: auto;
      min-height: 0;
    }

    .cabilo-layout-frame-image[data-fit-mode="height-to-width"],
    .cabilo-layout-frame-video[data-fit-mode="height-to-width"],
    .cabilo-layout-frame-turntable[data-fit-mode="height-to-width"],
    .cabilo-layout-frame-aov[data-fit-mode="height-to-width"] {
      height: clamp(240px, calc(var(--layout-h) * 18vw), 520px);
      min-height: 240px;
    }

    .cabilo-layout-frame-text {
      min-height: clamp(240px, calc(var(--layout-h) * 18vw), 520px);
      height: auto;
    }

    .cabilo-layout-frame-aov {
      min-height: 0;
      height: auto;
    }

    .cabilo-layout-frame-aov .cabilo-layout-aov {
      height: auto;
    }

    .cabilo-layout-frame-aov .cabilo-layout-aov :global(dynamic-aov) {
      height: auto !important;
      min-height: 0 !important;
    }

    .cabilo-layout-frame-aov .cabilo-layout-aov :global(dynamic-aov > div) {
      height: auto !important;
      min-height: 0 !important;
    }

    .cabilo-layout-frame-aov .cabilo-layout-aov :global(.aov-container) {
      flex: none;
      width: 100%;
      height: auto;
      aspect-ratio: 16 / 9;
    }

    .cabilo-layout-text {
      height: auto;
      min-height: inherit;
      overflow: visible;
    }

    .cabilo-layout-media,
    .cabilo-layout-video,
    .cabilo-layout-turntable {
      height: 100%;
      min-height: 0;
    }

    .cabilo-layout-turntable :global(turntable-scrubber) {
      height: 100%;
      min-height: 0;
    }

    .cabilo-layout-turntable :global(#tt-container) {
      min-height: 0;
      height: auto !important;
    }
  }
</style>

<script>
  const layoutSections = document.querySelectorAll('.cabilo-layout-blocks');

  const setAssetRatio = (frame, width, height) => {
    if (!width || !height) return;

    frame.style.setProperty(
      '--asset-aspect-ratio',
      `${width} / ${height}`,
    );
  };

  const loadLayoutAssetRatio = (frame) => {
    const fitMode = frame.dataset.fitMode;

    if (fitMode === 'none') return;

    const applyRatio = (width, height) => {
      if (!width || !height) return;

      setAssetRatio(frame, width, height);
      requestAnimationFrame(() => {
        frame.dispatchEvent(new Event('layout-aspect-ready'));
      });
    };

    const type = frame.dataset.assetType;

    if (type === 'image') {
      const image = frame.querySelector('[data-layout-asset]');

      if (image instanceof HTMLImageElement) {
        if (image.naturalWidth && image.naturalHeight) {
          applyRatio(image.naturalWidth, image.naturalHeight);
        } else {
          image.addEventListener('load', () => {
            applyRatio(image.naturalWidth, image.naturalHeight);
          }, { once: true });
        }
      }

      return;
    }

    if (type === 'video') {
      const video = frame.querySelector('[data-layout-asset]');

      if (video instanceof HTMLVideoElement) {
        if (video.videoWidth && video.videoHeight) {
          applyRatio(video.videoWidth, video.videoHeight);
        } else {
          video.addEventListener('loadedmetadata', () => {
            applyRatio(video.videoWidth, video.videoHeight);
          }, { once: true });
        }
      } else {
        const ratio = frame
          .querySelector('.cabilo-layout-video')
          ?.getAttribute('data-layout-video-ratio');

        if (ratio) {
          const parts = ratio.split('/').map((part) => Number(part.trim()));

          if (parts.length === 2 && parts[0] > 0 && parts[1] > 0) {
            applyRatio(parts[0], parts[1]);
          }
        }
      }

      return;
    }

    if (type === 'aov' || type === 'turntable') {
      const source = frame
        .querySelector('[data-layout-asset-src]')
        ?.getAttribute('data-layout-asset-src');

      if (!source) return;

      const image = new Image();

      image.onload = () => {
        applyRatio(image.naturalWidth, image.naturalHeight);
      };

      image.src = source;
    }
  };

  layoutSections.forEach((section) => {
    const aspectFrames = section.querySelectorAll(
      '.cabilo-layout-frame[data-fit-mode]:not([data-fit-mode="none"])',
    );

    aspectFrames.forEach((frame) => {
      loadLayoutAssetRatio(frame);
    });

    const frames = Array.from(
      section.querySelectorAll('.cabilo-layout-frame'),
    );

    const resolveLayout = () => {
      if (window.matchMedia('(max-width: 767px)').matches) {
        section.style.height = '';
        frames.forEach((frame) => {
          frame.style.top = '';
          frame.style.left = '';
          frame.style.width = '';
          frame.style.height = '';
          frame.style.marginBottom = '';

          if (frame.dataset.assetType === 'turntable') {
            const status = frame.querySelector('#tt-status');

            if (status instanceof HTMLElement) {
              const frameRect = frame.getBoundingClientRect();
              const statusRect = status.getBoundingClientRect();
              const overflow = Math.max(
                0,
                statusRect.bottom - frameRect.bottom,
              );

              if (overflow > 0) {
                frame.style.marginBottom = overflow + 'px';
              }
            }
          }
        });
        return;
      }

      /*
       * The CMS Y position is authoritative.
       *
       * Fit modes are allowed to make a block physically taller than its
       * authored slot, but they never move another block individually.
       * Instead, the row that contains the oversized block becomes elastic:
       * every later authored row starts after the previous row's actual
       * footprint.
       *
       * This gives us the useful part of collision handling without turning
       * the layout into a physics system. Blocks in the same authored row
       * therefore always stay together, while the empty space below that row
       * expands when its content needs more room.
       */
      const resolved = frames.map((frame) => {
        const x = Number(frame.style.getPropertyValue('--layout-x'));
        const y = Number(frame.style.getPropertyValue('--layout-y'));
        const w = Number(frame.style.getPropertyValue('--layout-w'));
        const h = Number(frame.style.getPropertyValue('--layout-h'));

        return {
          frame,
          x,
          y,
          w,
          h,
          resolvedY: y,
          resolvedW: w,
          resolvedH: h,
          collisionH: h,
        };
      });

      resolved.sort((a, b) => a.y - b.y || a.x - b.x);

      const rowHeight = parseFloat(
        getComputedStyle(section).getPropertyValue('--cabilo-layout-row-height'),
      ) || 1;

      /*
       * First determine the actual footprint required by each block.
       * Width → Height can grow vertically from its asset/content ratio.
       * Height → Width can grow horizontally without affecting row flow.
       */
      resolved.forEach((item) => {
        const fitMode = item.frame.dataset.fitMode;

        if (fitMode === 'width-to-height') {
          let measuredHeight = item.frame.scrollHeight / rowHeight * 2;

          /*
           * Turntable media sizing must come from the media container only.
           * Its out-of-flow status readout is measured separately below.
           */
          if (item.frame.dataset.assetType === 'turntable') {
            const container = item.frame.querySelector('#tt-container');

            if (container instanceof HTMLElement) {
              const containerHeight = container.getBoundingClientRect().height;

              if (containerHeight > 0) {
                measuredHeight = containerHeight / rowHeight * 2;
              }
            }
          }

          if (Number.isFinite(measuredHeight) && measuredHeight > item.resolvedH) {
            item.resolvedH = measuredHeight;
          }
        }

        if (fitMode === 'height-to-width') {
          const measuredWidth =
            item.frame.scrollWidth / section.clientWidth * 10;

          if (Number.isFinite(measuredWidth) && measuredWidth > item.resolvedW) {
            item.resolvedW = measuredWidth;
          }

          /*
           * AOV is a composite block: its authored height controls the
           * comparison viewport, but the pass selector panel lives below
           * that viewport and can become taller when its buttons wrap.
           *
           * Preserve the existing AOV measurement model because it already
           * handles that composite footprint correctly.
           */
          if (item.frame.dataset.assetType === 'aov') {
            const aov = item.frame.querySelector('dynamic-aov');

            if (aov instanceof HTMLElement) {
              const frameRect = item.frame.getBoundingClientRect();
              const aovRect = aov.getBoundingClientRect();
              const paddingBottom = parseFloat(
                getComputedStyle(item.frame).paddingBottom,
              ) || 0;
              const measuredHeightPx =
                aovRect.bottom - frameRect.top + paddingBottom;
              const measuredHeight = measuredHeightPx / rowHeight * 2;

              if (Number.isFinite(measuredHeight) && measuredHeight > item.resolvedH) {
                item.resolvedH = measuredHeight;
              }
            }
          }

          /*
           * Turntable has two different footprints:
           * - resolvedH controls the media box and therefore its aspect ratio.
           * - collisionH includes the readout below the media so later rows
           *   stay clear of it.
           *
           * The readout is intentionally never fed back into resolvedH.
           */
          if (item.frame.dataset.assetType === 'turntable') {
            const turntable = item.frame.querySelector('turntable-scrubber');
            const container = item.frame.querySelector('#tt-container');
            const status = item.frame.querySelector('#tt-status');

            if (
              turntable instanceof HTMLElement &&
              container instanceof HTMLElement &&
              status instanceof HTMLElement
            ) {
              const frameRect = item.frame.getBoundingClientRect();
              const mediaRect = container.getBoundingClientRect();
              const statusRect = status.getBoundingClientRect();
              const paddingBottom = parseFloat(
                getComputedStyle(item.frame).paddingBottom,
              ) || 0;

              const collisionBottomPx =
                Math.max(mediaRect.bottom, statusRect.bottom) -
                frameRect.top +
                paddingBottom;

              const collisionHeight = collisionBottomPx / rowHeight * 2;

              if (Number.isFinite(collisionHeight)) {
                item.collisionH = Math.max(
                  item.resolvedH,
                  collisionHeight,
                );
              }
            }
          }
        }
      });

      resolved.forEach((item) => {
        item.collisionH = Math.max(
          item.collisionH,
          item.resolvedH,
        );
      });

      /*
       * Build physical row offsets from authored row starts.
       *
       * Example:
       *   row 8  -> actual bottom 18
       *   row 13 -> shifted to 18
       *
       * The blocks that authored themselves at row 13 all receive the same
       * offset, so they remain a single visual row instead of being pushed
       * independently.
       */
      const rowStarts = [...new Set(resolved.map((item) => item.y))]
        .sort((a, b) => a - b);

      const rowOffsets = new Map();
      let previousPhysicalBottom = 0;

      rowStarts.forEach((rowStart) => {
        const rowItems = resolved.filter((item) => item.y === rowStart);
        const rowOffset = Math.max(0, previousPhysicalBottom - rowStart);

        rowOffsets.set(rowStart, rowOffset);

        const physicalBottom = Math.max(
          ...rowItems.map(
            (item) => rowStart + rowOffset + item.collisionH,
          ),
        );

        previousPhysicalBottom = Math.max(
          previousPhysicalBottom,
          physicalBottom,
        );
      });

      resolved.forEach((item) => {
        const fitMode = item.frame.dataset.fitMode;
        const rowOffset = rowOffsets.get(item.y) || 0;

        item.resolvedY = item.y + rowOffset;

        item.frame.style.top =
          String(item.resolvedY / 2 * rowHeight) + 'px';

        if (fitMode === 'width-to-height') {
          item.frame.style.height =
            String(item.resolvedH / 2 * rowHeight) + 'px';
        }

        if (fitMode === 'height-to-width') {
          item.frame.style.width =
            String(item.resolvedW / 10 * section.clientWidth) + 'px';
        }
      });

      let requiredHeight = 0;

      resolved.forEach((item) => {
        requiredHeight = Math.max(
          requiredHeight,
          item.resolvedY / 2 * rowHeight +
            item.collisionH / 2 * rowHeight,
        );
      });

      section.style.height = Math.max(
        section.scrollHeight,
        requiredHeight,
      ) + 'px';
    };

    resolveLayout();

    const observer = new ResizeObserver(() => {
      requestAnimationFrame(resolveLayout);
    });

    frames.forEach((frame) => {
      observer.observe(frame);

      /*
       * Composite blocks such as AOV and Turntable can change their internal
       * footprint without changing the authored frame itself. Observe their
       * rendered components so image loading and internal reflow can trigger
       * another elastic-row calculation.
       */
      const dynamicAov = frame.querySelector('dynamic-aov');

      if (dynamicAov instanceof HTMLElement) {
        observer.observe(dynamicAov);
      }

      const turntable = frame.querySelector('turntable-scrubber');

      if (turntable instanceof HTMLElement) {
        observer.observe(turntable);

        const turntableContainer =
          turntable.querySelector('#tt-container');

        if (turntableContainer instanceof HTMLElement) {
          observer.observe(turntableContainer);
        }
      }
    });

    window.addEventListener('resize', resolveLayout);
  });
</script>