---
// src/components/PortfolioGrid.astro
import ProjectCard from './ProjectCard.astro';
// We import Astro's collection fetching tool!
import { getCollection } from 'astro:content';

// Fetch all markdown files from the 'projects' folder
const allProjects = await getCollection('projects');
---

<section id="work" class="max-w-7xl mx-auto px-6 py-12 md:py-24">
  
  <div class="flex items-center justify-between mb-12">
    <h2 class="text-3xl md:text-4xl font-bold text-text-white uppercase tracking-wider">
      Selected <span class="text-text-silver font-light">Works</span>
    </h2>
    
    <div class="hidden md:flex gap-6 text-sm uppercase tracking-widest font-medium">
      <button class="text-brand-gold">All</button>
      <button class="text-text-silver hover:text-text-white transition-colors">Cinematics</button>
      <button class="text-text-silver hover:text-text-white transition-colors">Lookdev</button>
    </div>
  </div>

  <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8">
    
    <!-- We dynamically loop through the Markdown files to create the grid! -->
    {allProjects.map((project) => (
      <ProjectCard 
        title={project.data.title} 
        category={project.data.category} 
        image={project.data.thumbnail} 
        link={`/projects/${project.id}`} 
      />
    ))}

  </div>
</section>