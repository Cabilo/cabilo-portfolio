---
// src/components/PortfolioGrid.astro
import ProjectCard from './ProjectCard.astro';
import { getCollection } from 'astro:content';
import { getLocaleFromId, getLocalizedId, getLocalizedPath } from '../lib/i18n';

const locale = Astro.currentLocale === 'pt-br' ? 'pt-br' : 'en';
const allProjects = (await getCollection('projects')).filter(project => getLocaleFromId(project.id) === locale);

// 1. Extract all unique categories from your projects
const uniqueCategories = [locale === 'pt-br' ? 'Todos' : 'All', ...new Set(allProjects.map(project => project.data.category))];
---

<section id="work" class="max-w-7xl mx-auto px-6 py-12 md:py-24">
  
  <div class="flex flex-col md:flex-row md:items-center justify-between gap-6 mb-12">
    <h2 class="text-3xl md:text-4xl font-bold text-text-white uppercase tracking-wider">
      {locale === 'pt-br' ? 'Trabalhos' : 'Selected'} <span class="text-text-silver font-light">{locale === 'pt-br' ? 'Selecionados' : 'Works'}</span>
    </h2>
    
    <!-- 2. Dynamically generate the filter buttons! -->
    <div id="filter-buttons" class="flex flex-wrap gap-4 md:gap-6 text-sm uppercase tracking-widest font-medium">
      {uniqueCategories.map((category, index) => (
        <button 
          type="button"
          class={`filter-btn transition-colors duration-300 ${index === 0 ? 'text-brand-gold' : 'text-text-silver hover:text-text-white'}`}
          data-category={category}
          data-all-filter={index === 0 ? 'true' : 'false'}
        >
          {category}
        </button>
      ))}
    </div>
  </div>

  <div id="portfolio-grid" class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8">
    
    <!-- We add data-category to each card so the JavaScript knows how to filter them! -->
    {allProjects.map((project) => (
      <div class="project-item transition-all duration-500 ease-in-out" data-category={project.data.category}>
        <ProjectCard 
          title={project.data.title} 
          category={project.data.category} 
          image={project.data.thumbnail} 
          crop={project.data.thumbnailCrop}
          compress={project.data.compressThumbnail}
          link={getLocalizedPath(locale, `projects/${getLocalizedId(project.id)}`)} 
        />
      </div>
    ))}

  </div>
</section>

<!-- 3. The JavaScript that makes the filtering actually work! -->
<script>
  function initPortfolioFilters() {
    const buttons = document.querySelectorAll('.filter-btn');
    const items = document.querySelectorAll('.project-item');

    if (!buttons.length || !items.length) return;

    buttons.forEach((button) => {
      if (button.getAttribute('data-filter-bound') === 'true') return;
      button.setAttribute('data-filter-bound', 'true');

      button.addEventListener('click', () => {
        const selectedCategory = button.getAttribute('data-category');
        const isAllFilter = button.getAttribute('data-all-filter') === 'true';

        buttons.forEach((btn) => {
          btn.classList.remove('text-brand-gold');
          btn.classList.add('text-text-silver', 'hover:text-text-white');
        });
        button.classList.add('text-brand-gold');
        button.classList.remove('text-text-silver', 'hover:text-text-white');

        items.forEach((item) => {
          if (!(item instanceof HTMLElement)) return;

          const itemCategory = item.getAttribute('data-category');

          if (isAllFilter || itemCategory === selectedCategory) {
            item.style.display = 'block';
            setTimeout(() => {
              item.style.opacity = '1';
              item.style.transform = 'scale(1)';
            }, 50);
          } else {
            item.style.opacity = '0';
            item.style.transform = 'scale(0.95');
            setTimeout(() => {
              item.style.display = 'none';
            }, 300);
          }
        });
      });
    });
  }

  // Support both the first page load and Astro client-side navigation.
  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', initPortfolioFilters, { once: true });
  } else {
    initPortfolioFilters();
  }

  document.addEventListener('astro:page-load', initPortfolioFilters);
</script>
