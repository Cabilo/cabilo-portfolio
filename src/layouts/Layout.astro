---
// src/layouts/Layout.astro
import { getEntry } from 'astro:content';
import { ClientRouter } from 'astro:transitions';
import '../styles/global.css';
import Navbar from '../components/Navbar.astro'; 
import Footer from '../components/Footer.astro'; 

// Fetch the Global SEO defaults from the HOME page now!
const homePage = await getEntry('pages', 'home');

export interface Props {
  title?: string;
  description?: string;
  image?: string;
}

// Fallbacks point to homePage.data
const { 
  title = homePage?.data.globalSeoTitle || "CABILO | Senior 3D Artist & Cinematics",
  description = homePage?.data.globalSeoDescription || "Portfolio of CABILO, a Senior 3D Artist.",
  image = homePage?.data.globalSeoImage || "/favicon.svg"
} = Astro.props;

const siteUrl = Astro.site ? Astro.site.origin : 'https://cabilo.vercel.app';
const currentUrl = new URL(Astro.url.pathname, siteUrl).href;

// Force absolute image URL for Discord/LinkedIn
const absoluteImageUrl = image.startsWith('http') ? image : new URL(image, siteUrl).href;
---

<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="author" content="CABILO" />
    
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={currentUrl} />
    <meta property="og:image" content={absoluteImageUrl} />
    
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />

    <ClientRouter />
  </head>
  <body class="bg-cabilo-obsidian text-text-silver min-h-screen font-sans antialiased flex flex-col">
    
    <Navbar />
    
    <div class="pt-24 flex-grow">
      <slot />
    </div>

    <Footer />

  </body>
</html>