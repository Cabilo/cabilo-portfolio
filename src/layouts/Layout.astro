---
// src/layouts/Layout.astro
import { getEntry } from 'astro:content';
import { ClientRouter } from 'astro:transitions';
import '../styles/global.css';
import Navbar from '../components/Navbar.astro'; 
import Footer from '../components/Footer.astro'; 

// Fetch the Global SEO defaults from the CMS
const seoPage = await getEntry('pages', 'seo');

export interface Props {
  title?: string;
  description?: string;
  image?: string;
}

// If a specific project passes SEO data, use it. Otherwise, use the CMS defaults!
const { 
  title = seoPage?.data.globalSeoTitle || "CABILO | Senior 3D Artist & Cinematics",
  description = seoPage?.data.globalSeoDescription || "Portfolio of CABILO, a Senior 3D Artist.",
  image = seoPage?.data.globalSeoImage || "/favicon.svg"
} = Astro.props;

const currentUrl = new URL(Astro.url.pathname, Astro.site || 'https://cabilo.vercel.app').href;
---

<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="author" content="CABILO" />
    
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={currentUrl} />
    <meta property="og:image" content={image} />
    
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />

    <ClientRouter />
  </head>
  <body class="bg-cabilo-obsidian text-text-silver min-h-screen font-sans antialiased flex flex-col">
    
    <Navbar />
    
    <div class="pt-24 flex-grow">
      <slot />
    </div>

    <Footer />

  </body>
</html>